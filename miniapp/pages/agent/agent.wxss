page { width:100%; min-height:100%; overflow-x:hidden; background:#eef5fa; color:#172033; }
.page { width:100%; min-height:100%; padding:40rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); box-sizing:border-box; background:radial-gradient(circle at 14% 8%,rgba(56,189,248,.19),transparent 34%),radial-gradient(circle at 88% 20%,rgba(99,102,241,.14),transparent 32%),linear-gradient(180deg,#eaf5fb,#f3f6fb 520rpx); }
.hero { display:flex; flex-direction:column; align-items:center; padding:36rpx 20rpx 42rpx; }
.spark { width:96rpx; height:96rpx; border-radius:30rpx; display:flex; align-items:center; justify-content:center; color:#fff; font-size:48rpx; background:linear-gradient(145deg,#667eea,#7c3aed); box-shadow:0 18rpx 42rpx rgba(99,102,241,.28); }
.title { margin-top:24rpx; font-size:40rpx; font-weight:700; }
.subtitle { margin-top:12rpx; color:#64748b; font-size:27rpx; text-align:center; line-height:1.7; }
.card,.notice { margin-bottom:24rpx; padding:32rpx; border:1rpx solid var(--glass-border); border-radius:30rpx; background:var(--glass-bg); box-shadow:var(--glass-shadow),var(--glass-highlight),var(--glass-refraction); backdrop-filter:none; }
.card-title,.status-title,.notice-title { display:block; font-size:32rpx; font-weight:700; }
.status-row { display:flex; align-items:center; gap:14rpx; }
.status-dot { width:18rpx; height:18rpx; border-radius:50%; background:#10b981; box-shadow:0 0 0 8rpx rgba(16,185,129,.12); }
.description,.notice text:last-child { display:block; margin-top:18rpx; color:#64748b; font-size:27rpx; line-height:1.7; }
.examples { margin-top:20rpx; padding:20rpx; border:1rpx solid rgba(255,255,255,.65); border-radius:20rpx; background:linear-gradient(135deg,rgba(255,255,255,.34),rgba(255,255,255,.10)); box-shadow:var(--glass-highlight); display:flex; flex-direction:column; gap:12rpx; color:#475569; font-size:27rpx; }
.button { margin-top:28rpx; border-radius:22rpx; font-size:29rpx; font-weight:600; }
.button::after { border:0; }
.primary { color:#fff; background:linear-gradient(135deg,#6366f1,#7c3aed); }
.danger { color:#dc2626; background:#fff1f2; }
.secondary { color:#4f46e5; background:#eef2ff; }
.qr-box { margin-top:24rpx; display:flex; flex-direction:column; align-items:center; }
.qr-image { width:430rpx; height:430rpx; padding:12rpx; border:1rpx solid rgba(255,255,255,.88); background:rgba(255,255,255,.92); border-radius:24rpx; box-shadow:0 18rpx 42rpx rgba(42,65,105,.12),var(--glass-highlight); }
.qr-tip { margin-top:16rpx; color:#64748b; font-size:25rpx; text-align:center; }
.verify-row { width:100%; margin-top:18rpx; display:flex; gap:12rpx; align-items:center; }
.verify-input { flex:1; height:76rpx; padding:0 20rpx; border:1rpx solid #cbd5e1; border-radius:16rpx; background:#fff; }
.verify-button { width:150rpx; margin:0; color:#fff; background:#6366f1; border-radius:16rpx; font-size:27rpx; }
.divider { margin-top:30rpx; text-align:center; color:#94a3b8; font-size:24rpx; }
.code-box { margin-top:28rpx; padding:30rpx 20rpx; border-radius:24rpx; background:linear-gradient(145deg,#eef2ff,#f5f3ff); text-align:center; }
.code { display:block; color:#4f46e5; font-size:56rpx; font-weight:800; letter-spacing:12rpx; }
.expiry,.copy { display:block; margin-top:14rpx; color:#64748b; font-size:25rpx; }
.copy { color:#6366f1; }
.status-dot.off { background:#cbd5e1; box-shadow:0 0 0 8rpx rgba(148,163,184,.12); }
.qr-hint { display:block; margin-top:10rpx; color:#94a3b8; font-size:23rpx; text-align:center; line-height:1.5; }
.feedback-entry { display:flex; min-height:118rpx; padding:24rpx 28rpx; align-items:center; justify-content:space-between; border:1rpx solid var(--glass-border); border-radius:26rpx; background:linear-gradient(135deg,rgba(255,255,255,.18),rgba(99,102,241,.08)); box-shadow:var(--glass-shadow),var(--glass-highlight); }
.feedback-entry-copy { min-width:0; }
.feedback-entry-title { display:block; color:#3730a3; font-size:28rpx; font-weight:700; }
.feedback-entry-desc { display:block; margin-top:7rpx; color:#64748b; font-size:23rpx; line-height:1.45; }
.feedback-entry-arrow { margin-left:20rpx; color:#6366f1; font-size:48rpx; line-height:1; }
.feedback-entry-hover { opacity:.78; transform:scale(.985); }

/* ===== 自定义全透高质感毛玻璃弹窗（替代原生 wx.showModal） ===== */
.confirm-mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:70;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40rpx;
  background:radial-gradient(circle at 50% 50%, rgba(15,23,42,.32) 0%, rgba(15,23,42,.56) 100%);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  animation:modal-fade-in .2s ease-out;
}
.confirm-dialog {
  width:100%;
  max-width:580rpx;
  padding:48rpx 36rpx 36rpx;
  border-radius:36rpx;
  background:linear-gradient(145deg, rgba(255,255,255,.92) 0%, rgba(244,248,255,.82) 100%);
  border:1rpx solid rgba(255,255,255,.95);
  box-shadow:0 30rpx 60rpx -12rpx rgba(25,35,60,.28), 0 14rpx 24rpx -6rpx rgba(25,35,60,.15), inset 0 2px .8px rgba(255,255,255,.98), inset 0 -1.5px 1px rgba(180,200,230,.30);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
  animation:modal-pop-in .28s cubic-bezier(0.34, 1.56, 0.64, 1);
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  box-sizing:border-box;
  max-height:calc(100% - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow-y:auto;
}

@media (max-width:360px) {
  .page { padding-left:20rpx; padding-right:20rpx; }
  .card,.notice { padding:26rpx 22rpx; }
  .qr-image { width:380rpx; height:380rpx; max-width:100%; }
  .verify-row { flex-wrap:wrap; }
  .verify-input { min-width:0; }
}

@media (orientation:landscape) {
  .page { padding-top:24rpx; }
  .hero { padding-top:16rpx; padding-bottom:28rpx; }
  .qr-image { width:340rpx; height:340rpx; }
}
.confirm-title {
  font-size:35rpx;
  font-weight:780;
  color:#0f172a;
  letter-spacing:-.3rpx;
  margin-bottom:16rpx;
}
.confirm-content {
  font-size:27rpx;
  line-height:1.58;
  color:#475569;
  margin-bottom:38rpx;
  padding:0 12rpx;
  word-break:break-word;
}
.confirm-actions {
  display:flex;
  width:100%;
  gap:18rpx;
}
.confirm-btn {
  flex:1;
  height:82rpx;
  min-height:82rpx;
  border-radius:22rpx;
  font-size:28rpx;
  font-weight:650;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all .18s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing:border-box;
  margin:0;
  padding:0;
}
.confirm-btn::after { border:0; }
.confirm-btn-cancel {
  background:rgba(255,255,255,.70);
  color:#475569;
  border:1rpx solid rgba(148,163,184,.35);
  box-shadow:0 4rpx 10rpx rgba(0,0,0,.04), inset 0 1px .5px rgba(255,255,255,.9);
}
.confirm-btn-cancel:active {
  background:rgba(255,255,255,.92);
  transform:scale(.97);
}
.confirm-btn-primary {
  background:linear-gradient(135deg, #6366f1, #7c3aed);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(99,102,241,.38), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-primary:active {
  transform:scale(.97);
  filter:brightness(.95);
}
.confirm-btn-danger {
  background:linear-gradient(135deg, #f43f5e, #e11d48);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(225,29,72,.40), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-danger:active {
  transform:scale(.97);
  filter:brightness(.95);
}

@keyframes modal-fade-in {
  from { opacity:0; }
  to { opacity:1; }
}
@keyframes modal-pop-in {
  from { opacity:0; transform:scale(.92); }
  to { opacity:1; transform:scale(1); }
}
