page { width:100%; min-height:100%; overflow-x:hidden; background:#cde4fa; color:#172033; }
.page {
  width:100%;
  min-height:100%;
  padding:40rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing:border-box;
  background:
    radial-gradient(circle at 14% 8%, rgba(99, 102, 241, 0.36), transparent 42%),
    radial-gradient(circle at 88% 18%, rgba(56, 189, 248, 0.45), transparent 40%),
    linear-gradient(155deg, #d2e7fa 0%, #dce8f8 50%, #eaf2fd 100%);
}
.hero { display:flex; flex-direction:column; align-items:center; padding:36rpx 20rpx 42rpx; }
.spark { width:96rpx; height:96rpx; border-radius:30rpx; display:flex; align-items:center; justify-content:center; color:#fff; font-size:48rpx; background:linear-gradient(135deg,#0ea5e9,#2563eb); box-shadow:0 14rpx 32rpx rgba(14,165,233,.30); }
.title { margin-top:24rpx; font-size:40rpx; font-weight:700; }
.subtitle { margin-top:12rpx; color:#64748b; font-size:27rpx; text-align:center; line-height:1.7; }
.card,.notice {
  margin-bottom:24rpx;
  padding:32rpx;
  border:1.5rpx solid var(--glass-regular-border);
  border-radius:var(--radius-lg);
  background:var(--glass-regular-bg);
  box-shadow:var(--glass-regular-shadow), var(--glass-regular-highlight), var(--glass-regular-refraction);
  backdrop-filter:var(--glass-regular-blur);
  -webkit-backdrop-filter:var(--glass-regular-blur);
}
.card-title,.status-title,.notice-title { display:block; font-size:32rpx; font-weight:700; }
.status-row { display:flex; align-items:center; gap:14rpx; }
.status-dot { width:18rpx; height:18rpx; border-radius:50%; background:#10b981; box-shadow:0 0 0 8rpx rgba(16,185,129,.12); }
.description,.notice text:last-child { display:block; margin-top:18rpx; color:#64748b; font-size:27rpx; line-height:1.7; }
.examples { margin-top:20rpx; padding:20rpx; border:1rpx solid var(--glass-subtle-border); border-radius:var(--radius-sm); background:var(--glass-subtle-bg); box-shadow:var(--glass-subtle-shadow); display:flex; flex-direction:column; gap:12rpx; color:#475569; font-size:27rpx; }
.button {
  margin-top:28rpx;
  border-radius:var(--radius-pill);
  font-size:29rpx;
  font-weight:650;
  transition:opacity .15s ease;
}
.button::after { border:0; }
.button:active { opacity:.82; }
.primary { color:#fff; background:linear-gradient(135deg,#0ea5e9,#2563eb); box-shadow:0 12rpx 28rpx rgba(14,165,233,.30), inset 0 1.5rpx 0.5rpx rgba(255,255,255,.65); }
.danger { color:#dc2626; background:#fff1f2; }
.secondary { color:#0369a1; background:#e0f2fe; }
.qr-box { margin-top:24rpx; display:flex; flex-direction:column; align-items:center; }
.qr-image { width:520rpx; height:520rpx; padding:12rpx; border:1rpx solid rgba(255,255,255,.90); background:rgba(255,255,255,.94); border-radius:30rpx; box-shadow:0 18rpx 42rpx rgba(42,65,105,.12),var(--glass-highlight); }
.qr-save { margin-top:20rpx; width:340rpx; }
.qr-tip { margin-top:16rpx; color:#64748b; font-size:25rpx; text-align:center; }
.verify-row { width:100%; margin-top:18rpx; display:flex; gap:12rpx; align-items:center; }
.verify-input { flex:1; height:80rpx; padding:0 22rpx; border:1rpx solid var(--glass-subtle-border); border-radius:var(--radius-sm); background:var(--glass-subtle-bg); box-shadow:inset 0 1.5rpx 0.5rpx rgba(255,255,255,.9); }
.verify-button { width:156rpx; margin:0; color:#fff; background:linear-gradient(135deg,#0ea5e9,#2563eb); border-radius:var(--radius-pill); font-size:27rpx; font-weight:650; }
.divider { margin-top:30rpx; text-align:center; color:#94a3b8; font-size:24rpx; }
.code-box { margin-top:28rpx; padding:30rpx 20rpx; border-radius:28rpx; border:1rpx solid var(--glass-subtle-border); background:var(--glass-subtle-bg); box-shadow:inset 0 1.5rpx 0.5rpx rgba(255,255,255,.95); text-align:center; }
.code { display:block; color:#0284c7; font-size:56rpx; font-weight:800; letter-spacing:12rpx; }
.expiry,.copy { display:block; margin-top:14rpx; color:#64748b; font-size:25rpx; }
.copy { color:#0284c7; }
.status-dot.off { background:#cbd5e1; box-shadow:0 0 0 8rpx rgba(148,163,184,.12); }
.qr-hint { display:block; margin-top:10rpx; color:#94a3b8; font-size:23rpx; text-align:center; line-height:1.5; }
.feedback-entry {
  display:flex;
  min-height:118rpx;
  padding:24rpx 28rpx;
  align-items:center;
  justify-content:space-between;
  border:1rpx solid var(--glass-regular-border);
  border-radius:var(--radius-lg);
  background:var(--glass-regular-bg);
  box-shadow:var(--glass-regular-shadow), var(--glass-regular-highlight);
  transition:background .2s ease, opacity .15s ease;
}
.feedback-entry-copy { min-width:0; }
.feedback-entry-title { display:block; color:#0f172a; font-size:28rpx; font-weight:700; }
.feedback-entry-desc { display:block; margin-top:7rpx; color:#64748b; font-size:23rpx; line-height:1.45; }
.feedback-entry-arrow { margin-left:20rpx; color:#0284c7; font-size:48rpx; line-height:1; }
.feedback-entry-hover { opacity:.82; }

/* ===== 自定义全透高质感毛玻璃弹窗（替代原生 wx.showModal） ===== */
.confirm-mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:70;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40rpx;
  background:radial-gradient(circle at 50% 50%, rgba(15,23,42,.32) 0%, rgba(15,23,42,.56) 100%);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  animation:modal-fade-in .2s ease-out;
}
.confirm-dialog {
  width:100%;
  max-width:580rpx;
  padding:48rpx 36rpx 36rpx;
  border-radius:36rpx;
  background:linear-gradient(145deg, rgba(255,255,255,.90) 0%, rgba(244,248,255,.78) 100%);
  border:1rpx solid rgba(255,255,255,.95);
  box-shadow:0 30rpx 60rpx -12rpx rgba(25,35,60,.28), 0 14rpx 24rpx -6rpx rgba(25,35,60,.15), inset 0 2px .8px rgba(255,255,255,.98), inset 0 -1.5px 1px rgba(180,200,230,.30);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
  animation:modal-pop-in .28s cubic-bezier(0.34, 1.56, 0.64, 1);
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  box-sizing:border-box;
  max-height:calc(100% - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow-y:auto;
}

@media (max-width:360px) {
  .page { padding-left:20rpx; padding-right:20rpx; }
  .card,.notice { padding:26rpx 22rpx; }
  .qr-image { width:380rpx; height:380rpx; max-width:100%; }
  .verify-row { flex-wrap:wrap; }
  .verify-input { min-width:0; }
}

@media (orientation:landscape) {
  .page { padding-top:24rpx; }
  .hero { padding-top:16rpx; padding-bottom:28rpx; }
  .qr-image { width:340rpx; height:340rpx; }
}
.confirm-title {
  font-size:35rpx;
  font-weight:780;
  color:#0f172a;
  letter-spacing:-.3rpx;
  margin-bottom:16rpx;
}
.confirm-content {
  font-size:27rpx;
  line-height:1.58;
  color:#475569;
  margin-bottom:38rpx;
  padding:0 12rpx;
  word-break:break-word;
}
.confirm-actions {
  display:flex;
  width:100%;
  gap:18rpx;
}
.confirm-btn {
  flex:1;
  height:82rpx;
  min-height:82rpx;
  border-radius:22rpx;
  font-size:28rpx;
  font-weight:650;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all .18s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing:border-box;
  margin:0;
  padding:0;
}
.confirm-btn::after { border:0; }
.confirm-btn-cancel {
  background:rgba(255,255,255,.70);
  color:#475569;
  border:1rpx solid rgba(148,163,184,.35);
  box-shadow:0 4rpx 10rpx rgba(0,0,0,.04), inset 0 1px .5px rgba(255,255,255,.9);
}
.confirm-btn-cancel:active {
  background:rgba(255,255,255,.94);
  opacity:.82;
}
.confirm-btn-primary {
  background:linear-gradient(135deg, #0ea5e9, #0284c7);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(2,132,199,.38), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-primary:active {
  opacity:.85;
}
.confirm-btn-danger {
  background:linear-gradient(135deg, #f43f5e, #e11d48);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(225,29,72,.40), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-danger:active {
  opacity:.85;
}

@keyframes modal-fade-in {
  from { opacity:0; }
  to { opacity:1; }
}
@keyframes modal-pop-in {
  from { opacity:0; transform:scale(.92); }
  to { opacity:1; transform:scale(1); }
}
