page { width:100%; height:100%; overflow:hidden; background-color:#cde4fa; }
.page { position:fixed; top:0; right:0; bottom:0; left:0; width:100%; height:100%; background-color:#cde4fa; }
.page-content {
  min-height:100%;
  padding:30rpx 24rpx calc(42rpx + env(safe-area-inset-bottom));
  background:
    radial-gradient(circle at 14% 10%, rgba(99, 102, 241, 0.36) 0%, transparent 45%),
    radial-gradient(circle at 86% 16%, rgba(56, 189, 248, 0.45) 0%, transparent 42%),
    linear-gradient(155deg, #d2e7fa 0%, #dce8f8 50%, #eaf2fd 100%);
}
.editor-header { padding:18rpx 12rpx 30rpx; }
.editor-eyebrow { display:block; color:#0284c7; font-size:20rpx; font-weight:700; letter-spacing:2rpx; }
.editor-title { display:block; margin-top:8rpx; color:#172033; font-size:43rpx; font-weight:800; }
.editor-subtitle { display:block; max-width:620rpx; margin-top:12rpx; color:#64748b; font-size:23rpx; line-height:1.65; }
.form-card {
  padding:30rpx 26rpx;
  border:1.5rpx solid var(--glass-regular-border);
  border-radius:var(--radius-lg);
  background:var(--glass-regular-bg);
  box-shadow:var(--glass-regular-shadow), var(--glass-regular-highlight), var(--glass-regular-refraction);
  backdrop-filter:var(--glass-regular-blur);
  -webkit-backdrop-filter:var(--glass-regular-blur);
}
.field { margin-bottom:25rpx; }
.field-last { margin-bottom:0; }
.field-label { display:block; margin:0 0 11rpx 4rpx; color:#475569; font-size:24rpx; font-weight:650; }
.required { color:#ef4444; }
.input,.picker {
  display:flex;
  width:100%;
  min-height:86rpx;
  padding:0 24rpx;
  align-items:center;
  justify-content:space-between;
  border:1rpx solid var(--glass-subtle-border);
  border-radius:var(--radius-sm);
  background:var(--glass-subtle-bg);
  box-shadow:var(--glass-subtle-shadow), inset 0 1.5rpx 0.5rpx rgba(255,255,255,.95);
  color:#172033;
  font-size:27rpx;
  backdrop-filter:var(--glass-subtle-blur);
  -webkit-backdrop-filter:var(--glass-subtle-blur);
}
.input { height:86rpx; }
.picker text { color:#94a3b8; font-size:34rpx; }
.placeholder { color:#a8b3c2; }
.field-row { display:flex; }
.field-half { min-width:0; flex:1; }
.field-half + .field-half { margin-left:16rpx; }
.field-tip { display:block; margin:11rpx 4rpx 0; color:#94a3b8; font-size:20rpx; line-height:1.5; }
.form-actions { display:flex; margin-top:28rpx; }
.form-actions .btn + .btn { margin-left:14rpx; }
.delete-button {
  padding:0 26rpx;
  border:1rpx solid rgba(244,63,94,.32);
  border-radius:var(--radius-pill);
  color:#dc2626;
  background:linear-gradient(135deg, rgba(254,226,226,.7), rgba(254,205,211,.35));
  box-shadow:inset 0 1.5rpx 0.5rpx rgba(255,255,255,.9);
}
.cancel-button { flex:1; border-radius:var(--radius-pill); }
.save-button { flex:2; border-radius:var(--radius-pill); }
@media (max-width:360px) {
  .page-content { padding-left:18rpx; padding-right:18rpx; }
  .form-card { padding:26rpx 20rpx; }
  .field-row { display:block; }
  .field-half + .field-half { margin-left:0; }
  .form-actions { flex-wrap:wrap; }
  .delete-button { width:100%; margin-bottom:14rpx; }
  .form-actions .delete-button + .btn { margin-left:0; }
}

/* 课程颜色选择 */
.color-grid { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:8rpx; }
.color-swatch { width:60rpx; height:60rpx; border-radius:50%; border:4rpx solid rgba(255,255,255,.9); box-shadow:0 2rpx 8rpx rgba(51,65,85,.18); transition:border-color .2s ease; }
.color-swatch.selected { border-color:#0284c7; box-shadow:0 4rpx 14rpx rgba(2,132,199,.35); }

/* ===== 夜间模式 ===== */
.night .page { background:#0b1220; color:#e2e8f0; }
.night .page-content { background:radial-gradient(circle at 20% 10%,rgba(30,64,175,.22),transparent 40%),linear-gradient(180deg,#0b1220 0,#0b1220 100%); }
.night .editor-title,.night .picker { color:#f1f5f9; }
.night .editor-subtitle,.night .field-label,.night .field-tip { color:#94a3b8; }
.night .form-card { border-color:var(--glass-border); background:var(--glass-bg); }
.night .input {
  border-color:rgba(148,163,184,.28);
  background:linear-gradient(135deg, rgba(30,41,59,.65), rgba(15,23,42,.45));
  box-shadow:inset 0 1.5rpx 0.5rpx rgba(255,255,255,.16);
  color:#f1f5f9;
}
.night .input .placeholder,.night .placeholder { color:#64748b; }
.night .cancel-button { background:rgba(30,41,59,.7); color:#cbd5e1; border-color:rgba(148,163,184,.25); }
.night .color-swatch { border-color:rgba(30,41,59,.8); }
.night .color-swatch.selected { border-color:#f1f5f9; }

/* ===== 自定义全透高质感毛玻璃弹窗（替代原生 wx.showModal） ===== */
.confirm-mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:70;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40rpx;
  background:radial-gradient(circle at 50% 50%, rgba(15,23,42,.32) 0%, rgba(15,23,42,.56) 100%);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  animation:modal-fade-in .2s ease-out;
}
.confirm-dialog {
  width:100%;
  max-width:580rpx;
  padding:48rpx 36rpx 36rpx;
  border-radius:36rpx;
  background:linear-gradient(145deg, rgba(255,255,255,.90) 0%, rgba(244,248,255,.78) 100%);
  border:1rpx solid rgba(255,255,255,.95);
  box-shadow:0 30rpx 60rpx -12rpx rgba(25,35,60,.28), 0 14rpx 24rpx -6rpx rgba(25,35,60,.15), inset 0 2px .8px rgba(255,255,255,.98), inset 0 -1.5px 1px rgba(180,200,230,.30);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
  animation:modal-pop-in .28s cubic-bezier(0.34, 1.56, 0.64, 1);
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  box-sizing:border-box;
  max-height:calc(100% - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow-y:auto;
}

@media (orientation:landscape) {
  .page-content { padding-top:18rpx; }
  .editor-header { padding-top:8rpx; padding-bottom:18rpx; }
  .editor-subtitle { max-width:none; }
}
.confirm-title {
  font-size:35rpx;
  font-weight:780;
  color:#0f172a;
  letter-spacing:-.3rpx;
  margin-bottom:16rpx;
}
.confirm-content {
  font-size:27rpx;
  line-height:1.58;
  color:#475569;
  margin-bottom:38rpx;
  padding:0 12rpx;
  word-break:break-word;
}
.confirm-actions {
  display:flex;
  width:100%;
  gap:18rpx;
}
.confirm-btn {
  flex:1;
  height:82rpx;
  min-height:82rpx;
  border-radius:22rpx;
  font-size:28rpx;
  font-weight:650;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all .18s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing:border-box;
  margin:0;
  padding:0;
}
.confirm-btn::after { border:0; }
.confirm-btn-cancel {
  background:rgba(255,255,255,.70);
  color:#475569;
  border:1rpx solid rgba(148,163,184,.35);
  box-shadow:0 4rpx 10rpx rgba(0,0,0,.04), inset 0 1px .5px rgba(255,255,255,.9);
}
.confirm-btn-cancel:active {
  background:rgba(255,255,255,.94);
  opacity:.82;
}
.confirm-btn-primary {
  background:linear-gradient(135deg, #0ea5e9, #0284c7);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(2,132,199,.38), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-primary:active {
  opacity:.85;
}
.confirm-btn-danger {
  background:linear-gradient(135deg, #f43f5e, #e11d48);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(225,29,72,.40), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-danger:active {
  opacity:.85;
}

.night .confirm-dialog {
  background:linear-gradient(145deg, rgba(15,23,42,.90) 0%, rgba(30,41,59,.82) 100%);
  border-color:rgba(148,163,184,.28);
  box-shadow:0 30rpx 60rpx -12rpx rgba(0,0,0,.65), 0 14rpx 24rpx -6rpx rgba(0,0,0,.4), inset 0 1.5px .5px rgba(255,255,255,.18), inset 0 -1.5px 1px rgba(0,0,0,.45);
}
.night .confirm-title { color:#f8fafc; }
.night .confirm-content { color:#94a3b8; }
.night .confirm-btn-cancel {
  background:rgba(30,41,59,.72);
  color:#cbd5e1;
  border-color:rgba(148,163,184,.25);
  box-shadow:inset 0 1px .5px rgba(255,255,255,.12);
}
.night .confirm-btn-cancel:active { background:rgba(51,65,85,.85); }

@keyframes modal-fade-in {
  from { opacity:0; }
  to { opacity:1; }
}
@keyframes modal-pop-in {
  from { opacity:0; transform:scale(.92); }
  to { opacity:1; transform:scale(1); }
}
