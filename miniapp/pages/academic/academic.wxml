<view class="academic-page {{nightMode ? 'night' : ''}} {{backgroundPath ? 'has-wallpaper' : ''}}">
  <block wx:if="{{backgroundPath}}">
    <image class="page-wallpaper" src="{{backgroundPath}}" mode="aspectFill"></image>
    <view class="page-wallpaper-tint"></view>
  </block>
  <view class="ambient" wx:else aria-hidden="true">
    <view class="orb orb-a"></view>
    <view class="orb orb-b"></view>
    <view class="orb orb-c"></view>
    <view class="orb orb-d"></view>
  </view>

  <scroll-view class="academic-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="academic-content {{selected && !bound ? 'has-binding-bar' : ''}}">
      <!-- 页面顶部 Hero -->
      <view class="academic-hero">
        <view class="hero-badge-box">
          <text class="hero-badge-icon">🏫</text>
        </view>
        <text class="hero-title">绑定学校身份</text>
        <text class="hero-desc">选择自己的姓名和班级，绑定后可同步学校课表。</text>
      </view>

      <!-- 当前状态卡片 -->
      <view class="card academic-status-card" wx:if="{{syncStatus || bound}}">
        <view class="status-badge-row">
          <view class="status-dot-pulse"></view>
          <text class="status-label">{{bound ? '已关联学校身份' : '同步任务中'}}</text>
        </view>
        <text wx:if="{{syncStatus}}" class="status-task-msg">{{syncStatus}}</text>
        <block wx:if="{{bound}}">
          <view class="bound-info-grid">
            <view class="bound-info-item">
              <text class="bound-label">学生姓名</text>
              <text class="bound-value">{{bound.name}}</text>
            </view>
            <view class="bound-info-item">
              <text class="bound-label">所属班级</text>
              <text class="bound-value">{{bound.class_name}}</text>
            </view>
          </view>
          <text class="bound-sync-time">最近同步时间：{{lastSyncedText || '尚未同步'}}</text>
        </block>
      </view>

      <!-- 未绑定时的搜索卡片 -->
      <view class="card academic-form-card" wx:if="{{!bound}}">
        <text class="form-card-title">查找我的学校信息</text>
        <view class="academic-field-group">
          <view class="field-item">
            <text class="field-item-label">姓名、专业、班级或年级</text>
            <input class="field-input" value="{{keyword}}" maxlength="80" disabled="{{busy}}" placeholder="如：张三、计算机、24计科7班、25" placeholder-class="field-placeholder" bindinput="inputKeyword" confirm-type="search" bindconfirm="search"/>
          </view>
          <text class="form-card-subtitle">支持部分文字，如“计科”或“24”。选择自己的信息后确认绑定。</text>
        </view>
        <button class="btn primary search-btn" disabled="{{busy || !keyword}}" loading="{{busy}}" bindtap="search">搜索学校身份</button>

        <view wx:if="{{notice}}" class="academic-notice">{{notice}}</view>
        <view class="academic-alert error-alert" wx:if="{{error}}">
          <text class="alert-icon">⚠️</text>
          <text class="alert-text">{{error}}</text>
        </view>
        <view class="academic-alert info-alert" wx:if="{{busy && !error}}">
          <view class="alert-spinner mini"></view>
          <text class="alert-text">正在查找学生信息，请稍候…</text>
        </view>
      </view>

      <!-- 搜索结果匹配学生列表 -->
      <view class="card students-card" wx:if="{{!bound && students.length}}">
        <text class="form-card-title">请选择你的学生档案</text>
        <text class="form-card-subtitle">匹配到以下学生，点击确认身份：</text>
        <view class="students-list">
          <view class="student-item-card {{selected && selected.id === item.id ? 'selected' : ''}}" wx:for="{{students}}" wx:key="id" data-id="{{item.id}}" bindtap="choose" hover-class="student-item-hover">
            <view class="student-avatar-glyph">{{item.name[0] || '学'}}</view>
            <view class="student-info">
              <text class="student-name">{{item.name}}</text>
              <text class="student-meta">{{item.grade}}级 · {{item.major_name}} · {{item.class_name}} · {{item.student_number_display}}</text>
            </view>
            <view class="student-arrow-wrap">
              <text class="student-arrow">›</text>
            </view>
          </view>
        </view>
      </view>

      <view class="card empty-card" wx:elif="{{!bound && searched && !busy}}">
        <text class="empty-icon">🔍</text>
        <text class="empty-title">未找到匹配学生</text>
        <text class="empty-desc">试试姓名、专业或班级的部分文字，例如“计科”或“24计科7班”。</text>
      </view>

      <view class="academic-alert error-alert" wx:if="{{bound && error}}"><text class="alert-text">{{error}}</text></view>
      <!-- 已选档案或已绑定身份的操作管理面板 -->
      <view class="card manage-card" wx:if="{{bound}}">
        <view class="manage-head">
          <view class="manage-user-badge">
            <text class="manage-user-name">{{selected.name}}</text>
            <text class="manage-user-class">{{selected.class_name}}</text>
          </view>
        </view>

        <view wx:if="{{bound && terms.length}}" class="field-item">
          <text class="field-item-label">选择要同步的学期</text>
          <picker range="{{terms}}" value="{{termIndex}}" disabled="{{busy}}" bindchange="changeTerm">
            <view class="field-picker">
              <text>{{terms[termIndex]}}</text>
              <text class="picker-arrow">▾</text>
            </view>
          </picker>
        </view>

        <view class="manage-actions">
          <button wx:if="{{bound}}" class="btn primary" disabled="{{busy || !terms.length}}" loading="{{busy}}" bindtap="syncSchool">同步学校课表</button>
          <text wx:if="{{bound}}" class="sync-tip-text">同步成功后账号只保留一份学校课表，导入课表和个人修改将被覆盖；覆盖前保留最近5次恢复记录，失败时保留现有课表。</text>
          <button wx:if="{{bound}}" class="btn danger-button unbind-btn" disabled="{{busy}}" bindtap="unbindSchool">解除绑定 / 更换学生身份</button>
        </view>
      </view>

      <view class="card manage-card">
        <button class="btn" disabled="{{busy}}" bindtap="restoreSchoolBackup">高级：恢复历史课表</button>
        <text class="sync-tip-text">可恢复最近5次覆盖前的课表和调课；恢复后，后续自动同步仍会更新学校课表。</text>
      </view>
      <view class="bottom-safe"></view>
    </view>
  </scroll-view>
  <view wx:if="{{selected && !bound}}" class="binding-action-bar">
    <view class="binding-action-info">
      <text class="binding-action-name">已选择：{{selected.name}}</text>
      <text class="binding-action-class">{{selected.class_name}} · {{selected.major_name}}</text>
    </view>
    <button class="btn primary binding-action-button" disabled="{{busy}}" loading="{{busy}}" bindtap="bindSchool">确认绑定</button>
  </view>
</view>
