.week-input { width:120rpx; color:#172033; font-size:25rpx; font-weight:650; text-align:right; }
.calculate-button { width:100%; height:68rpx; margin:14rpx 0 0; border:1rpx solid rgba(125,211,252,.4); border-radius:17rpx; background:rgba(14,165,233,.10); color:#087ca7; font-size:22rpx; line-height:68rpx; }
.danger-button { margin-right:12rpx; color:#b4232f; background:rgba(244,63,94,.10); }
/* 学期设置底部操作栏：删除在左侧独立隔离，取消与保存居右成组，避免误触且严防屏幕右侧溢出 */
