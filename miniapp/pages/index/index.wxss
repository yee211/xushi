/* ===== 弹窗/面板动画 ===== */
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes dialog-in { from { opacity: 0; transform: translateY(64rpx) scale(.96); } to { opacity: 1; transform: none; } }
@keyframes panel-in { from { opacity: 0; transform: translateY(-10rpx); } to { opacity: 1; transform: none; } }
.mask { animation: mask-in .2s ease-out; }
.dialog { animation: dialog-in .28s cubic-bezier(.34,1.4,.64,1); }
.week-panel { animation: panel-in .18s ease-out; }

/* ===== 交互补充 ===== */
