.night .privacy-link { color:#7dd3fc; }
.parse-help { display:block; margin:-6rpx 0 20rpx; color:#64748b; font-size:23rpx; line-height:1.55; }
.dialog-close-btn { width:100%; margin-top:14rpx; margin-bottom:18rpx; flex:none; }
.detail-dialog { padding-top:18rpx; }
.detail-title-row { display:flex; margin:10rpx 0 24rpx; align-items:center; }
.detail-color { width:18rpx; height:54rpx; margin-right:14rpx; border-radius:9rpx; }
.detail-title { min-width:0; overflow:hidden; color:#172033; font-size:36rpx; font-weight:780; text-overflow:ellipsis; white-space:nowrap; }
