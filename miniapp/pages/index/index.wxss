/* ===== 自定义全透高质感毛玻璃弹窗与操作菜单（替代原生 wx.showModal / wx.showActionSheet） ===== */
.confirm-mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:70;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40rpx;
  background:radial-gradient(circle at 50% 50%, rgba(15,23,42,.32) 0%, rgba(15,23,42,.56) 100%);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  animation:modal-fade-in .2s ease-out;
}
.confirm-dialog {
  width:100%;
  max-width:580rpx;
  padding:48rpx 36rpx 36rpx;
  border-radius:36rpx;
  background:linear-gradient(145deg, rgba(255,255,255,.90) 0%, rgba(244,248,255,.78) 100%);
  border:1rpx solid rgba(255,255,255,.95);
  box-shadow:0 30rpx 60rpx -12rpx rgba(25,35,60,.28), 0 14rpx 24rpx -6rpx rgba(25,35,60,.15), inset 0 2px .8px rgba(255,255,255,.98), inset 0 -1.5px 1px rgba(180,200,230,.30);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
  animation:modal-pop-in .28s cubic-bezier(0.34, 1.56, 0.64, 1);
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  box-sizing:border-box;
  max-height:calc(100% - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow-y:auto;
}
.confirm-title {
  font-size:35rpx;
  font-weight:780;
  color:#0f172a;
  letter-spacing:-.3rpx;
  margin-bottom:16rpx;
}
.confirm-content {
  font-size:27rpx;
  line-height:1.58;
  color:#475569;
  margin-bottom:38rpx;
  padding:0 12rpx;
  word-break:break-word;
}
.confirm-actions {
  display:flex;
  width:100%;
  gap:18rpx;
}
.confirm-btn {
  flex:1;
  height:82rpx;
  min-height:82rpx;
  border-radius:22rpx;
  font-size:28rpx;
  font-weight:650;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all .18s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing:border-box;
  margin:0;
  padding:0;
}
.confirm-btn::after { border:0; }
.confirm-btn-cancel {
  background:rgba(255,255,255,.70);
  color:#475569;
  border:1rpx solid rgba(148,163,184,.35);
  box-shadow:0 4rpx 10rpx rgba(0,0,0,.04), inset 0 1px .5px rgba(255,255,255,.9);
}
.confirm-btn-cancel:active {
  background:rgba(255,255,255,.92);
  transform:scale(.97);
}
.confirm-btn-primary {
  background:linear-gradient(135deg, #0ea5e9, #0284c7);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(2,132,199,.38), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-primary:active {
  transform:scale(.97);
  filter:brightness(.95);
}
.confirm-btn-danger {
  background:linear-gradient(135deg, #f43f5e, #e11d48);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(225,29,72,.40), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-danger:active {
  transform:scale(.97);
  filter:brightness(.95);
}

/* 操作面板 ActionSheet */
.actionsheet-mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:70;
  display:flex;
  align-items:flex-end;
  background:radial-gradient(circle at 50% 50%, rgba(15,23,42,.32) 0%, rgba(15,23,42,.56) 100%);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  animation:modal-fade-in .2s ease-out;
}
.actionsheet-dialog {
  width:100%;
  padding:22rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius:40rpx 40rpx 0 0;
  background:linear-gradient(145deg, rgba(255,255,255,.92) 0%, rgba(244,248,255,.82) 100%);
  border:1rpx solid rgba(255,255,255,.95);
  border-bottom:0;
  box-shadow:0 -20rpx 50rpx -10rpx rgba(25,35,60,.25), inset 0 1.5px .5px rgba(255,255,255,.98);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
  animation:sheet-slide-up .28s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing:border-box;
  max-height:calc(100% - 24rpx - env(safe-area-inset-top));
  overflow-y:auto;
}

