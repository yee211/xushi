/* 课程添加/编辑弹窗 */
.course-editor-dialog { max-height:85vh; display:flex; flex-direction:column; }
.course-editor-header { display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:12rpx; }
.course-editor-body { max-height:58vh; margin:8rpx 0 16rpx; }
.course-field { margin-bottom:22rpx; }
.course-field-last { margin-bottom:10rpx; }
.course-field-label { display:block; margin:0 0 10rpx 4rpx; color:#475569; font-size:24rpx; font-weight:650; }
.course-field-label .required { color:#ef4444; }
.course-input, .course-picker {
  display:flex;
  width:100%;
  height:86rpx;
  min-height:86rpx;
  padding:0 22rpx;
  align-items:center;
  justify-content:space-between;
  border:1.5rpx solid rgba(226,232,240,.9);
  border-radius:20rpx;
  background:rgba(255,255,255,.85);
  box-shadow:inset 0 1.5rpx 1rpx rgba(255,255,255,1);
  color:#0f172a;
  font-size:26rpx;
  font-weight:600;
}
.course-picker text:last-child { color:#64748b; font-size:28rpx; }
.course-placeholder { color:#94a3b8; }
.course-field-row { display:flex; gap:16rpx; }
.course-field-half { min-width:0; flex:1; }
.course-field-tip { display:block; margin:9rpx 4rpx 0; color:#64748b; font-size:21rpx; line-height:1.4; }
.course-color-grid { display:flex; flex-wrap:wrap; gap:16rpx; margin-top:10rpx; padding:4rpx 0; }
.course-color-swatch { width:56rpx; height:56rpx; border-radius:50%; border:4rpx solid rgba(255,255,255,.9); box-shadow:0 2rpx 8rpx rgba(51,65,85,.18); transition:transform .2s ease; }
.course-color-swatch.selected { border-color:#0284c7; transform:scale(1.15); box-shadow:0 4rpx 14rpx rgba(2,132,199,.35); }
.course-editor-actions { display:flex; gap:16rpx; margin-top:20rpx; }
.course-editor-actions .btn { min-height:84rpx; height:84rpx; border-radius:24rpx; font-size:27rpx; font-weight:750; }
.course-editor-actions .danger-button { flex:none; padding:0 24rpx; }
.course-editor-actions .dialog-cancel { flex:1; }
.course-editor-actions .dialog-submit { flex:2; }

.night .course-field-label { color:#94a3b8; }
.night .course-input, .night .course-picker { border-color:rgba(148,163,184,.25); background:rgba(15,23,42,.6); color:#f1f5f9; }
.night .course-placeholder { color:#64748b; }
.night .course-field-tip { color:#64748b; }
.night .course-color-swatch { border-color:rgba(30,41,59,.8); }
.night .course-color-swatch.selected { border-color:#38bdf8; box-shadow:0 4rpx 14rpx rgba(56,189,248,.4); }

/* ===== 自定义全透高质感毛玻璃弹窗与操作菜单（替代原生 wx.showModal / wx.showActionSheet） ===== */
.confirm-mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:70;
  display:flex;
  align-items:center;
  justify-content:center;
  padding:40rpx;
  background:radial-gradient(circle at 50% 50%, rgba(15,23,42,.32) 0%, rgba(15,23,42,.56) 100%);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  animation:modal-fade-in .2s ease-out;
}
.confirm-dialog {
  width:100%;
  max-width:580rpx;
  padding:48rpx 36rpx 36rpx;
  border-radius:36rpx;
  background:linear-gradient(145deg, rgba(255,255,255,.90) 0%, rgba(244,248,255,.78) 100%);
  border:1rpx solid rgba(255,255,255,.95);
  box-shadow:0 30rpx 60rpx -12rpx rgba(25,35,60,.28), 0 14rpx 24rpx -6rpx rgba(25,35,60,.15), inset 0 2px .8px rgba(255,255,255,.98), inset 0 -1.5px 1px rgba(180,200,230,.30);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
  animation:modal-pop-in .28s cubic-bezier(0.34, 1.56, 0.64, 1);
  display:flex;
  flex-direction:column;
  align-items:center;
  text-align:center;
  box-sizing:border-box;
  max-height:calc(100% - env(safe-area-inset-top) - env(safe-area-inset-bottom));
  overflow-y:auto;
}
.confirm-title {
  font-size:35rpx;
  font-weight:780;
  color:#0f172a;
  letter-spacing:-.3rpx;
  margin-bottom:16rpx;
}
.confirm-content {
  font-size:27rpx;
  line-height:1.58;
  color:#475569;
  margin-bottom:38rpx;
  padding:0 12rpx;
  word-break:break-word;
}
.confirm-actions {
  display:flex;
  width:100%;
  gap:18rpx;
}
.confirm-btn {
  flex:1;
  height:82rpx;
  min-height:82rpx;
  border-radius:22rpx;
  font-size:28rpx;
  font-weight:650;
  display:flex;
  align-items:center;
  justify-content:center;
  transition:all .18s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing:border-box;
  margin:0;
  padding:0;
}
.confirm-btn::after { border:0; }
.confirm-btn-cancel {
  background:rgba(255,255,255,.70);
  color:#475569;
  border:1rpx solid rgba(148,163,184,.35);
  box-shadow:0 4rpx 10rpx rgba(0,0,0,.04), inset 0 1px .5px rgba(255,255,255,.9);
}
.confirm-btn-cancel:active {
  background:rgba(255,255,255,.94);
  opacity:.82;
}
.confirm-btn-primary {
  background:linear-gradient(135deg, #0ea5e9, #0284c7);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(2,132,199,.38), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-primary:active {
  opacity:.85;
}
.confirm-btn-danger {
  background:linear-gradient(135deg, #f43f5e, #e11d48);
  color:#ffffff;
  border:1rpx solid rgba(255,255,255,.45);
  box-shadow:0 8rpx 20rpx rgba(225,29,72,.40), inset 0 1.5px .5px rgba(255,255,255,.65);
}
.confirm-btn-danger:active {
  opacity:.85;
}

/* 操作面板 ActionSheet */
.actionsheet-mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:70;
  display:flex;
  align-items:flex-end;
  background:radial-gradient(circle at 50% 50%, rgba(15,23,42,.32) 0%, rgba(15,23,42,.56) 100%);
  backdrop-filter:blur(16px);
  -webkit-backdrop-filter:blur(16px);
  animation:modal-fade-in .2s ease-out;
}
.actionsheet-dialog {
  width:100%;
  padding:22rpx 26rpx calc(26rpx + env(safe-area-inset-bottom));
  border-radius:40rpx 40rpx 0 0;
  background:linear-gradient(145deg, rgba(255,255,255,.92) 0%, rgba(244,248,255,.82) 100%);
  border:1rpx solid rgba(255,255,255,.95);
  border-bottom:0;
  box-shadow:0 -20rpx 50rpx -10rpx rgba(25,35,60,.25), inset 0 1.5px .5px rgba(255,255,255,.98);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
  animation:sheet-slide-up .28s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing:border-box;
  max-height:calc(100% - 24rpx - env(safe-area-inset-top));
  overflow-y:auto;
}

@media (orientation:landscape) {
  .page-content { padding-top:12rpx; }
  .control-wrap,.timetable { margin-top:12rpx; }
  .week-panel-scroll { max-height:46vh; }
  .dialog { max-height:94%; }
  .detail-scroll,.records-list,.course-editor-body,.term-sheet-list { max-height:45vh; }
}
.actionsheet-handle {
  width:72rpx;
  height:8rpx;
  border-radius:4rpx;
  background:rgba(100,116,139,.32);
  margin:0 auto 24rpx;
}
.actionsheet-list {
  display:flex;
  flex-direction:column;
  gap:14rpx;
  margin-bottom:18rpx;
}
.actionsheet-item {
  width:100%;
  height:96rpx;
  min-height:96rpx;
  border-radius:24rpx;
  background:rgba(255,255,255,.68);
  border:1rpx solid rgba(255,255,255,.88);
  box-shadow:0 4rpx 12rpx rgba(0,0,0,.03), inset 0 1px .5px rgba(255,255,255,.92);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:29rpx;
  font-weight:650;
  color:#1e293b;
  transition:all .18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.actionsheet-item:active {
  background:rgba(255,255,255,.92);
  opacity:.82;
}
.actionsheet-item.danger-item {
  color:#e11d48;
}
.actionsheet-cancel-btn {
  width:100%;
  height:94rpx;
  min-height:94rpx;
  border-radius:24rpx;
  background:rgba(255,255,255,.82);
  border:1rpx solid rgba(148,163,184,.30);
  box-shadow:0 4rpx 12rpx rgba(0,0,0,.03);
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:29rpx;
  font-weight:600;
  color:#64748b;
  transition:all .18s cubic-bezier(0.34, 1.56, 0.64, 1);
  margin:0;
  padding:0;
}
.actionsheet-cancel-btn::after { border:0; }
.actionsheet-cancel-btn:active {
  background:rgba(255,255,255,.96);
  opacity:.82;
}

/* 黑夜模式 night */
.night .confirm-dialog {
  background:linear-gradient(145deg, rgba(15,23,42,.90) 0%, rgba(30,41,59,.82) 100%);
  border-color:rgba(148,163,184,.28);
