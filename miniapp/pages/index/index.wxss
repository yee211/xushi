page { background-color:#dcecf7; height:100%; overflow:hidden; }
.page-root {
  position:fixed;
  top:0;
  right:0;
  bottom:0;
  left:0;
  width:100vw;
  height:100%;
  min-height:100%;
  overflow:hidden;
  background:radial-gradient(circle at 18% 18%,rgba(129,140,248,.22),transparent 34%),radial-gradient(circle at 82% 24%,rgba(56,189,248,.20),transparent 32%),linear-gradient(145deg,#e6f3fa,#dce7f5);
  color:#172033;
}
.page-root.has-wallpaper { background:#dcecf7; }
.page-root.night {
  background:radial-gradient(circle at 18% 18%,rgba(30,64,175,.26),transparent 34%),linear-gradient(145deg,#07111f,#111827);
  color:#cbd5e1;
}
.page-root.night.has-wallpaper { background:#0b1220; }
.page-scroll, .page {
  position:absolute;
  top:0;
  right:0;
  bottom:0;
  left:0;
  width:100%;
  height:100%;
  z-index:1;
  -webkit-overflow-scrolling:touch;
}
.page-content {
  position:relative;
  min-height:100%;
  padding:20rpx 16rpx calc(200rpx + env(safe-area-inset-bottom));
  background:transparent;
}

/* ===== 氛围光斑层：给超清玻璃提供可折射的底色（容器禁 blur,光斑禁 pointer）===== */
.ambient { position:absolute; top:0; right:0; bottom:0; left:0; z-index:0; overflow:hidden; pointer-events:none; }
.orb { position:absolute; border-radius:50%; }
.orb-a { top:-140rpx; left:-120rpx; width:520rpx; height:520rpx; background:radial-gradient(circle at 35% 35%,rgba(129,140,248,.40),transparent 68%); }
.orb-b { top:60rpx; right:-160rpx; width:560rpx; height:560rpx; background:radial-gradient(circle at 40% 40%,rgba(56,189,248,.34),transparent 66%); }
.orb-c { top:540rpx; left:-180rpx; width:640rpx; height:640rpx; background:radial-gradient(circle at 45% 40%,rgba(45,212,191,.26),transparent 68%); }
.orb-d { top:960rpx; right:-140rpx; width:600rpx; height:600rpx; background:radial-gradient(circle at 40% 40%,rgba(244,114,182,.22),transparent 66%); }
.control-wrap,.timetable,.loading-card,.empty { position:relative; z-index:1; }

.appearance-button,.night-button,.icon-button,button.appearance-button,button.night-button {
  display:flex !important;
  width:64rpx !important;
  min-width:64rpx !important;
  max-width:64rpx !important;
  height:64rpx !important;
  min-height:64rpx !important;
  margin:0 !important;
  padding:0 !important;
  flex:0 0 64rpx !important;
  align-items:center !important;
  justify-content:center !important;
  border:1rpx solid var(--glass-border) !important;
  border-radius:18rpx !important;
  background:linear-gradient(135deg,rgba(255,255,255,.32),rgba(255,255,255,.12)) !important;
  box-shadow:var(--glass-highlight) !important;
  color:#285269 !important;
  box-sizing:border-box !important;
  transition:transform .12s ease, background .15s ease;
}
button.appearance-button::after,button.night-button::after { display:none !important; }
.icon-button-hover {
  transform:scale(.92);
  background:rgba(255,255,255,.50) !important;
}
.icon-symbol {
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:1;
}
.appearance-button .icon-symbol { font-size:30rpx; font-weight:700; }
.night-button .icon-symbol { font-size:28rpx; }
.week-badge { display:flex; width:76rpx; height:76rpx; align-items:center; justify-content:center; border:1rpx solid var(--glass-border); border-radius:50%; background:rgba(255,255,255,.10); font-size:17rpx; }
.week-number { margin:0 4rpx; font-size:31rpx; font-weight:800; }
/* 底部悬浮操作条：高频操作常驻，滚动区之外（fixed + 安全区） */
/* ===== 底部悬浮操作条：液态玻璃（受光微棱 + 背光折射 + 环境光投影 + 流光掠影）===== */
.action-dock { position:fixed; left:20rpx; right:20rpx; bottom:calc(18rpx + env(safe-area-inset-bottom)); z-index:18; display:flex; align-items:stretch; gap:8rpx; padding:12rpx 10rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.72); border-radius:34rpx; background:linear-gradient(135deg,rgba(255,255,255,.52) 0%,rgba(255,255,255,.18) 45%,rgba(236,244,255,.30) 100%); box-shadow:inset 0 1.5rpx 0.5rpx rgba(255,255,255,.95),inset 0 -1rpx 2rpx rgba(42,65,105,.10),0 24rpx 50rpx -12rpx rgba(42,65,105,.16),0 10rpx 20rpx -6rpx rgba(42,65,105,.08); backdrop-filter:blur(32px) saturate(180%); }
/* 受光微棱线：顶缘一道锐利高光 */
.action-dock::before { content:''; position:absolute; top:0; left:26rpx; right:26rpx; height:1rpx; background:linear-gradient(90deg,transparent,rgba(255,255,255,.95) 30%,rgba(255,255,255,.95) 70%,transparent); pointer-events:none; }
/* 流光掠影：斜向光带周期性扫过 */
.dock-sheen { position:absolute; top:-30%; bottom:-30%; left:0; width:38%; background:linear-gradient(105deg,transparent 0%,rgba(255,255,255,.42) 50%,transparent 100%); transform:translateX(-140%) skewX(-18deg); animation:dockSheen 6.5s ease-in-out infinite; pointer-events:none; }
@keyframes dockSheen { 0% { transform:translateX(-140%) skewX(-18deg); opacity:0; } 10% { opacity:1; } 52% { transform:translateX(400%) skewX(-18deg); opacity:1; } 53%,100% { transform:translateX(400%) skewX(-18deg); opacity:0; } }
.dock-item { display:flex; flex:1; min-width:0; flex-direction:column; align-items:center; justify-content:center; gap:4rpx; height:96rpx; margin:0; padding:0; border:0; border-radius:24rpx; background:linear-gradient(135deg,rgba(255,255,255,.30),rgba(255,255,255,.08)); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.65); color:#285269; font-size:20rpx; font-weight:650; line-height:1.2; transition:transform .25s var(--spring),background .2s ease,box-shadow .2s ease; }
.dock-item::after { display:none; }
.dock-item-hover { background:linear-gradient(135deg,rgba(255,255,255,.62),rgba(255,255,255,.28)); box-shadow:inset 0 1.5rpx 0 rgba(255,255,255,.95),0 6rpx 16rpx rgba(42,65,105,.10); transform:scale(.93); }
.dock-item[disabled] { opacity:.38; pointer-events:none; }
.dock-icon { font-size:30rpx; font-weight:750; line-height:1; transition:transform .25s var(--spring); }
.dock-item-hover .dock-icon { transform:translateY(-2rpx) scale(1.08); }
.dock-agent { color:#0779a6; background:linear-gradient(135deg,rgba(56,189,248,.30),rgba(56,189,248,.12)); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.7),0 4rpx 14rpx rgba(56,189,248,.18); }
.action-dock.dock-hidden { opacity:0; transform:translateY(40rpx); pointer-events:none; }
.night .action-dock { border-color:rgba(148,163,184,.30); background:linear-gradient(135deg,rgba(30,41,59,.62) 0%,rgba(15,23,42,.40) 45%,rgba(2,6,23,.50) 100%); box-shadow:inset 0 1.5rpx 0.5rpx rgba(255,255,255,.18),inset 0 -1rpx 2rpx rgba(0,0,0,.24),0 24rpx 50rpx -12rpx rgba(0,0,0,.42),0 10rpx 20rpx -6rpx rgba(0,0,0,.22); }
.night .action-dock::before { background:linear-gradient(90deg,transparent,rgba(255,255,255,.38) 30%,rgba(255,255,255,.38) 70%,transparent); }
.night .dock-sheen { background:linear-gradient(105deg,transparent 0%,rgba(255,255,255,.14) 50%,transparent 100%); }
.night .dock-item { background:linear-gradient(135deg,rgba(51,65,85,.55),rgba(30,41,59,.35)); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.14); color:#cbd5e1; }
.night .dock-item-hover { background:linear-gradient(135deg,rgba(71,85,105,.62),rgba(51,65,85,.42)); box-shadow:inset 0 1.5rpx 0 rgba(255,255,255,.22),0 6rpx 16rpx rgba(0,0,0,.30); }
.night .dock-agent { color:#7dd3fc; background:linear-gradient(135deg,rgba(56,189,248,.28),rgba(56,189,248,.12)); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.20),0 4rpx 14rpx rgba(56,189,248,.16); }
.has-wallpaper .action-dock { background:linear-gradient(135deg,rgba(255,255,255,.68) 0%,rgba(255,255,255,.30) 50%,rgba(240,246,255,.42) 100%); }
.has-wallpaper.night .action-dock { background:linear-gradient(135deg,rgba(15,23,42,.66) 0%,rgba(2,6,23,.52) 100%); }
.control-wrap { position:relative; z-index:12; margin-top:4rpx; }
.control-card { margin-top:0; overflow:hidden; }
.term-week-bar { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:88rpx; padding:10rpx 12rpx 10rpx 24rpx; }
.term-picker { display:flex; align-items:center; flex:1; min-width:0; }
.term-picker-hover { opacity:.72; }
.term-title-text { max-width:340rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#172033; font-size:26rpx; font-weight:700; }
.term-chevron { margin-left:8rpx; margin-right:12rpx; color:#64748b; font-size:19rpx; line-height:1; flex:none; opacity:.75; }
.week-inline { display:flex; align-items:stretch; gap:10rpx; flex:none; }
.week-chip { display:flex; align-items:center; gap:8rpx; min-height:64rpx; padding:0 22rpx; border-radius:20rpx; background:rgba(255,255,255,.30); }
.week-chip-text { color:#172033; font-size:27rpx; font-weight:750; white-space:nowrap; }
.week-chip-arrow { color:#087ca7; font-size:22rpx; line-height:1; opacity:.85; }
.week-chip-badge { flex:none; padding:3rpx 12rpx; border-radius:999rpx; background:rgba(56,189,248,.18); color:#0779a6; font-size:19rpx; font-weight:700; line-height:1.3; }
/* 周面板是浮层：唯一允许高斯模糊的容器之一（蓝图 modal 级） */
.week-panel { position:absolute; top:calc(100% + 12rpx); right:0; left:0; z-index:30; padding:18rpx 12rpx 20rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.85); border-radius:28rpx; background:linear-gradient(135deg,rgba(255,255,255,.88),rgba(244,250,255,.74)); box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.95),0 22rpx 54rpx rgba(42,65,105,.22); backdrop-filter:blur(36px) saturate(180%); }
.week-panel-scroll { height:610rpx; max-height:58vh; }
.week-panel-title { display:flex; padding:0 10rpx 14rpx; align-items:center; justify-content:space-between; color:#334155; font-size:24rpx; font-weight:700; }
.week-panel-title text + text { color:#94a3b8; font-size:19rpx; font-weight:400; }
.week-grid { display:flex; flex-wrap:wrap; }
.week-option { width:25%; padding:6rpx; }
.week-option-card { min-height:104rpx; padding:14rpx 4rpx 10rpx; border:1rpx solid var(--glass-border); border-radius:16rpx; background:rgba(255,255,255,.55); box-shadow:inset 0 1rpx 0 rgba(255,255,255,.95),0 5rpx 14rpx rgba(71,85,105,.06); text-align:center; transition:transform .25s var(--spring); }
.week-option-card.selected { border-color:#25c9ae; background:linear-gradient(135deg,#38d4b9,#22bfa7); box-shadow:0 7rpx 18rpx rgba(34,191,167,.22),inset 0 1.5px 0.5px rgba(255,255,255,.6); }
.week-option-title { display:block; color:#28323c; font-size:23rpx; line-height:1.35; }
.week-option-range { display:block; margin-top:7rpx; color:#8a949f; font-size:16rpx; line-height:1.2; }
.week-option-card.selected .week-option-title,.week-option-card.selected .week-option-range { color:#fff; }
.loading-card { margin-top:16rpx; padding:46rpx; color:#64748b; text-align:center; font-size:24rpx; }
/* ===== 空课表状态与使用说明（超清液态玻璃规范） ===== */
.empty { margin-top:16rpx; padding:48rpx 28rpx 36rpx; border-radius:32rpx; text-align:center; }
.empty-hero { display:flex; flex-direction:column; align-items:center; text-align:center; }
.empty-icon-box {
  display:flex;
  width:104rpx;
  height:104rpx;
  align-items:center;
  justify-content:center;
  border-radius:32rpx;
  background:linear-gradient(135deg,rgba(56,189,248,.20) 0%,rgba(37,99,235,.10) 100%);
  border:1rpx solid rgba(56,189,248,.30);
  box-shadow:0 12rpx 28rpx rgba(14,165,233,.18),inset 0 1.5px 0.5px rgba(255,255,255,.90);
}
.empty-icon-glyph { font-size:50rpx; line-height:1; }
.empty-title { display:block; margin-top:22rpx; color:#172033; font-size:34rpx; font-weight:800; letter-spacing:0.5rpx; }
.empty-desc { display:block; max-width:540rpx; margin:12rpx auto 28rpx; color:#64748b; font-size:24rpx; line-height:1.55; }
button.empty-button,
.empty-button {
  display:flex !important;
  width:320rpx !important;
  max-width:320rpx !important;
  height:86rpx !important;
  min-height:86rpx !important;
  margin:0 auto !important;
  padding:0 !important;
  align-items:center !important;
  justify-content:center !important;
  border:none !important;
  border-radius:26rpx !important;
  background:linear-gradient(135deg,#0ea5e9 0%,#2563eb 100%) !important;
  box-shadow:0 12rpx 28rpx rgba(14,165,233,.32),inset 0 1.5px 0.5px rgba(255,255,255,.50) !important;
  color:#fff !important;
  font-size:29rpx !important;
  font-weight:750 !important;
  transition:transform .15s ease, opacity .15s ease;
}
button.empty-button::after { display:none !important; }
.empty-button-icon { margin-right:6rpx; font-size:30rpx; font-weight:800; line-height:1; }
.empty-button-hover { transform:scale(.96); opacity:.90; }

/* 导入使用说明卡片 */
.empty-guide {
  margin-top:38rpx;
  padding:24rpx 22rpx 20rpx;
  border:1rpx solid rgba(148,163,184,.22);
  border-radius:24rpx;
  background:rgba(255,255,255,.62);
  box-shadow:inset 0 1px 0.5px rgba(255,255,255,.90);
  text-align:left;
}
.guide-head { display:flex; align-items:center; gap:10rpx; margin-bottom:20rpx; }
.guide-badge { font-size:26rpx; line-height:1; }
.guide-title { font-size:23rpx; font-weight:750; color:#0284c7; letter-spacing:0.3rpx; }
.guide-steps { display:flex; flex-direction:column; gap:16rpx; }
.guide-step { display:flex; align-items:flex-start; gap:16rpx; }
.step-badge {
  display:flex;
  width:36rpx;
  height:36rpx;
  min-width:36rpx;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:linear-gradient(135deg,#38bdf8 0%,#2563eb 100%);
  box-shadow:0 4rpx 10rpx rgba(14,165,233,.28);
  color:#fff;
  font-size:20rpx;
  font-weight:800;
  line-height:1;
  margin-top:2rpx;
}
.step-main { flex:1; min-width:0; }
.step-title { display:block; font-size:23rpx; font-weight:700; color:#1e293b; line-height:1.35; }
.step-desc { display:block; margin-top:4rpx; color:#64748b; font-size:21rpx; line-height:1.5; }
.guide-footer { margin-top:18rpx; padding-top:14rpx; border-top:1rpx dashed rgba(148,163,184,.26); }
.guide-footer-tip { display:block; color:#0284c7; font-size:20rpx; font-weight:550; line-height:1.5; }
/* 课表容器：纯透玻璃,壁纸/光斑 100% 透出 */
.timetable { position:relative; margin-top:24rpx; overflow:hidden; border:1rpx solid var(--glass-border); border-radius:24rpx; background:transparent; box-shadow:var(--glass-shadow),var(--glass-highlight); }
.page-wallpaper { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; z-index:0; pointer-events:none; }
.page-wallpaper-tint { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; z-index:0; pointer-events:none; background:rgba(255,255,255,.22); }
.page-wallpaper-bottom-fade {
  position:absolute;
  right:0;
  bottom:0;
  left:0;
  z-index:0;
  height:calc(120rpx + env(safe-area-inset-bottom));
  pointer-events:none;
  background:linear-gradient(180deg,rgba(243,246,251,0) 0%,rgba(243,246,251,.42) 48%,#f3f6fb 100%);
}
.has-wallpaper .page-content { background:transparent !important; }
.night.has-wallpaper .page-wallpaper-tint,
.night .page-wallpaper-tint { background:rgba(11,18,32,.58); }
.night .page-wallpaper-bottom-fade { background:linear-gradient(180deg,rgba(11,18,32,0) 0%,rgba(11,18,32,.52) 48%,#0b1220 100%); }
.timetable-content { position:relative; z-index:1; }
/* ===== 表头与网格：超清高透光学透镜规范 ===== */
.table-header { display:flex; height:108rpx; background:linear-gradient(180deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,.03) 100%); border-bottom:1rpx solid var(--hairline); box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.85); color:#1f3a4d; }
.section-head { display:flex; width:70rpx; flex:none; align-items:center; justify-content:center; flex-direction:column; border-right:1rpx solid var(--hairline); font-size:19rpx; line-height:1.45; }
.section-head text:first-child { color:#1e293b; font-size:22rpx; font-weight:700; line-height:1.2; }
.section-head text:last-child { color:#64748b; font-size:18rpx; margin-top:5rpx; line-height:1.2; }
.days-head { display:flex; min-width:0; flex:1; }
.day-head { display:flex; width:14.2857%; align-items:center; justify-content:center; flex-direction:column; border-right:1rpx solid var(--hairline); color:#2b4a5e; transition:background .2s ease; }
.head-date { font-size:22rpx; font-weight:700; color:#1e293b; line-height:1.2; }
.head-day { margin-top:5rpx; font-size:23rpx; font-weight:650; color:#64748b; line-height:1.2; }
.day-head.today { background:linear-gradient(180deg,rgba(56,189,248,.20) 0%,rgba(56,189,248,.03) 100%); box-shadow:inset 0 1.5px 0.5px rgba(56,189,248,.7); }
.day-head.today .head-date { color:#0284c7; font-weight:800; }
.day-head.today .head-day { color:#0284c7; font-weight:750; }
.table-body { position:relative; display:flex; }
.section-column { width:70rpx; flex:none; background:rgba(255,255,255,.06); }
.section-cell { display:flex; height:var(--row-height, 112rpx); align-items:center; justify-content:center; flex-direction:column; border-right:1rpx solid var(--hairline); border-bottom:1rpx solid var(--hairline); color:#425466; }
.section-number { font-size:26rpx; font-weight:700; line-height:1; color:#334155; }
.section-time { margin-top:5rpx; font-size:14rpx; line-height:1; color:#8292a3; }
.day-area { position:relative; display:flex; min-width:0; height:100%; flex:1; }
.day-column { width:14.2857%; }
/* 网格单元格：L0 晶透 1.5% 微光 */
.grid-cell { height:var(--row-height, 112rpx); border-right:1rpx solid var(--hairline); border-bottom:1rpx solid var(--hairline); background:rgba(255,255,255,.015); }
.course-slot { position:absolute; z-index:2; padding:4rpx 3rpx; }
/* 果冻水晶课程卡：渐变/边框/彩色投影由 JS 按课程色内联注入 */
.grid-course { width:100%; height:100%; padding:9rpx 7rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.58); border-radius:12rpx; color:#fff; }
.adjusted-tag { position:absolute; top:7rpx; right:6rpx; width:26rpx; height:26rpx; border-radius:50%; background:rgba(255,255,255,.92); color:#0f766e; font-size:16rpx; font-weight:800; line-height:26rpx; text-align:center; }
.grid-course-name { display:-webkit-box; -webkit-box-orient:vertical; overflow:hidden; font-size:20rpx; font-weight:750; line-height:1.25; word-break:break-all; text-shadow:0 1px 2px rgba(15,23,42,.30); }
.grid-course-meta { display:block; margin-top:5rpx; overflow:hidden; font-size:15rpx; line-height:1.25; text-overflow:ellipsis; white-space:nowrap; text-shadow:0 1px 2px rgba(15,23,42,.25); }
.no-course { position:absolute; top:32rpx; left:20rpx; right:20rpx; padding:24rpx; border-radius:16rpx; background:rgba(255,255,255,.50); color:#64748b; text-align:center; font-size:22rpx; }
.bottom-safe { height:18rpx; }
/* 遮罩与弹窗：唯一使用 backdrop-filter 的层级（蓝图 4） */
.mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:20; display:flex; align-items:flex-end; background:radial-gradient(circle at 50% 42%,rgba(15,23,42,.28),rgba(15,23,42,.46)); backdrop-filter:blur(14px); }
.dialog { width:100%; padding:18rpx 30rpx calc(30rpx + env(safe-area-inset-bottom)); border:1rpx solid rgba(255,255,255,.85); border-bottom:0; border-radius:38rpx 38rpx 0 0; background:linear-gradient(145deg,rgba(255,255,255,.86),rgba(244,248,255,.70)); box-shadow:0 -30rpx 60rpx -12rpx rgba(25,35,60,.24),inset 0 1.5px 0.5px rgba(255,255,255,.98),inset 0 -1.5px 1px rgba(180,200,230,.30); backdrop-filter:blur(36px) saturate(180%); }
.dialog { max-height:calc(100% - 24rpx - env(safe-area-inset-top)); overflow:hidden; }
.dialog-handle { width:76rpx; height:8rpx; margin:0 auto 28rpx; border-radius:4rpx; background:rgba(100,116,139,.35); }
.dialog-eyebrow { display:block; color:#0284c7; font-size:22rpx; font-weight:700; }
.dialog-title { display:block; margin:8rpx 0 24rpx; font-size:36rpx; font-weight:780; }
.term-field { margin-bottom:16rpx; }
.term-field-label { display:block; margin:0 0 9rpx 4rpx; color:#64748b; font-size:22rpx; }
.term-input { width:100%; height:82rpx; padding:0 20rpx; border:1rpx solid rgba(148,163,184,.28); border-radius:18rpx; background:rgba(255,255,255,.62); color:#172033; font-size:26rpx; }
