page { background-color:#cde4fa; height:100%; overflow:hidden; }
.page-root {
  position:fixed;
  top:0;
  right:0;
  bottom:0;
  left:0;
  width:100vw;
  height:100%;
  min-height:100%;
  overflow:hidden;
  /* 苹果液态极光背景：提供丰富的折射色彩与透光对比，杜绝死白一片 */
  background:
    radial-gradient(circle at 14% 14%, rgba(99, 102, 241, 0.45) 0%, transparent 46%),
    radial-gradient(circle at 86% 18%, rgba(56, 189, 248, 0.50) 0%, transparent 45%),
    radial-gradient(circle at 45% 60%, rgba(244, 114, 182, 0.30) 0%, transparent 52%),
    radial-gradient(circle at 82% 82%, rgba(14, 165, 233, 0.42) 0%, transparent 48%),
    linear-gradient(155deg, #d2e7fa 0%, #dce8f8 50%, #eaf2fd 100%);
  color:#172033;
}
.page-root.has-wallpaper { background:transparent; }
.page-root.night {
  background:
    radial-gradient(circle at 18% 14%, rgba(30, 58, 138, 0.35) 0%, transparent 46%),
    radial-gradient(circle at 82% 20%, rgba(14, 165, 233, 0.28) 0%, transparent 42%),
    linear-gradient(160deg, #070d19 0%, #0d1527 50%, #131d31 100%);
  color:#cbd5e1;
}
.page-root.night.has-wallpaper { background:#070d19; }
.page-scroll, .page {
  position:absolute;
  top:0;
  right:0;
  bottom:0;
  left:0;
  width:100%;
  height:100%;
  z-index:1;
  -webkit-overflow-scrolling:touch;
}
.page-content {
  position:relative;
  min-height:100%;
  padding:20rpx 16rpx calc(200rpx + env(safe-area-inset-bottom));
  background:transparent;
}

/* ===== 氛围光斑层：提供折射光源，产生生动的微光流动与毛玻璃晶莹质感 ===== */
.ambient { position:absolute; top:0; right:0; bottom:0; left:0; z-index:0; overflow:hidden; pointer-events:none; }
.orb { position:absolute; border-radius:50%; filter:blur(52rpx); opacity:.85; }
.orb-a { top:-100rpx; left:-80rpx; width:560rpx; height:560rpx; background:radial-gradient(circle at 35% 35%,rgba(99,102,241,.55),transparent 70%); animation:orbFloatA 18s ease-in-out infinite alternate; }
.orb-b { top:100rpx; right:-100rpx; width:580rpx; height:580rpx; background:radial-gradient(circle at 40% 40%,rgba(56,189,248,.58),transparent 68%); animation:orbFloatB 22s ease-in-out infinite alternate; }
.orb-c { top:600rpx; left:-120rpx; width:640rpx; height:640rpx; background:radial-gradient(circle at 45% 40%,rgba(45,212,191,.42),transparent 70%); animation:orbFloatC 20s ease-in-out infinite alternate; }
.orb-d { top:1000rpx; right:-100rpx; width:600rpx; height:600rpx; background:radial-gradient(circle at 40% 40%,rgba(244,114,182,.38),transparent 68%); animation:orbFloatD 24s ease-in-out infinite alternate; }

@keyframes orbFloatA { 0% { transform:translate(0, 0); } 50% { transform:translate(36rpx, 30rpx); } 100% { transform:translate(-24rpx, 46rpx); } }
@keyframes orbFloatB { 0% { transform:translate(0, 0); } 50% { transform:translate(-40rpx, 30rpx); } 100% { transform:translate(30rpx, 58rpx); } }
@keyframes orbFloatC { 0% { transform:translate(0, 0); } 50% { transform:translate(46rpx, -30rpx); } 100% { transform:translate(-30rpx, 36rpx); } }
@keyframes orbFloatD { 0% { transform:translate(0, 0); } 50% { transform:translate(-36rpx, -40rpx); } 100% { transform:translate(24rpx, 24rpx); } }

.control-wrap,.timetable,.loading-card,.empty { position:relative; z-index:1; }

.appearance-button,.night-button,.icon-button,button.appearance-button,button.night-button {
  display:flex !important;
  width:68rpx !important;
  min-width:68rpx !important;
  max-width:68rpx !important;
  height:68rpx !important;
  min-height:68rpx !important;
  margin:0 !important;
  padding:0 !important;
  flex:0 0 68rpx !important;
  align-items:center !important;
  justify-content:center !important;
  border:1rpx solid rgba(255,255,255,.85) !important;
  border-radius:50% !important;
  background:linear-gradient(135deg,rgba(255,255,255,.70),rgba(255,255,255,.35)) !important;
  box-shadow:0 6rpx 16rpx rgba(25,45,80,.10), inset 0 1.5rpx 0.5rpx rgba(255,255,255,1) !important;
  backdrop-filter:blur(24px) saturate(190%) !important;
  -webkit-backdrop-filter:blur(24px) saturate(190%) !important;
  color:#1e3a5f !important;
  box-sizing:border-box !important;
  transition:opacity .15s ease !important;
}
button.appearance-button::after,button.night-button::after { display:none !important; }
.icon-button-hover { opacity:.78 !important; }
.icon-symbol {
  display:flex;
  align-items:center;
  justify-content:center;
  line-height:1;
}
.appearance-button .icon-symbol { font-size:30rpx; font-weight:700; }
.night-button .icon-symbol { font-size:28rpx; }
.week-badge { display:flex; width:76rpx; height:76rpx; align-items:center; justify-content:center; border:1rpx solid var(--glass-regular-border); border-radius:50%; background:rgba(255,255,255,.24); font-size:17rpx; }
.week-number { margin:0 4rpx; font-size:31rpx; font-weight:800; }

/* 底部悬浮操作条：苹果控制中心级 Liquid 玻璃胶囊 */
.action-dock {
  position:fixed;
  left:28rpx;
  right:28rpx;
  bottom:calc(24rpx + env(safe-area-inset-bottom));
  z-index:18;
  display:flex;
  align-items:stretch;
  gap:10rpx;
  padding:12rpx 12rpx;
  overflow:hidden;
  border:1.5rpx solid rgba(255,255,255,.90);
  border-radius:var(--radius-pill);
  background:linear-gradient(135deg,rgba(255,255,255,.68) 0%,rgba(255,255,255,.32) 100%);
  box-shadow:
    inset 0 2rpx 1rpx rgba(255,255,255,1),
    0 24rpx 54rpx -10rpx rgba(25,45,80,.20),
    0 8rpx 20rpx -4rpx rgba(25,45,80,.08);
  backdrop-filter:blur(36px) saturate(200%);
  -webkit-backdrop-filter:blur(36px) saturate(200%);
}
/* 受光微棱线：顶缘一道纯白高光切面 */
.action-dock::before {
  content:'';
  position:absolute;
  top:0;
  left:36rpx;
  right:36rpx;
  height:1rpx;
  background:linear-gradient(90deg,transparent,rgba(255,255,255,1) 25%,rgba(255,255,255,1) 75%,transparent);
  pointer-events:none;
}
/* 流光掠影：斜向柔光周期性扫过 */
.dock-sheen { position:absolute; top:-30%; bottom:-30%; left:0; width:38%; background:linear-gradient(105deg,transparent 0%,rgba(255,255,255,.45) 50%,transparent 100%); transform:translateX(-140%) skewX(-18deg); animation:dockSheen 7.5s ease-in-out infinite; pointer-events:none; }
@keyframes dockSheen { 0% { transform:translateX(-140%) skewX(-18deg); opacity:0; } 10% { opacity:1; } 52% { transform:translateX(400%) skewX(-18deg); opacity:1; } 53%,100% { transform:translateX(400%) skewX(-18deg); opacity:0; } }
.dock-item {
  display:flex;
  flex:1;
  min-width:0;
  flex-direction:column;
  align-items:center;
  justify-content:center;
  gap:4rpx;
  height:96rpx;
  margin:0;
  padding:0;
  border:1rpx solid rgba(255,255,255,.45);
  border-radius:var(--radius-pill);
  background:linear-gradient(135deg,rgba(255,255,255,.16),rgba(255,255,255,.05));
  box-shadow:inset 0 1.5rpx 1rpx rgba(255,255,255,.92), inset 0 -1.5rpx 1.5rpx rgba(0,0,0,.10);
  color:#172033;
  font-size:21rpx;
  font-weight:650;
  line-height:1.2;
  transition:opacity .15s ease, background .15s ease;
}
.dock-item::after { display:none; }
.dock-item-hover {
  opacity:.88;
  background:rgba(255,255,255,.28);
}
.dock-item[disabled] { opacity:.38; pointer-events:none; }
.dock-icon { font-size:30rpx; font-weight:750; line-height:1; }
.dock-agent {
  color:#0369a1;
  background:linear-gradient(135deg,rgba(56,189,248,.26),rgba(56,189,248,.10));
  border-color:rgba(56,189,248,.55);
  box-shadow:inset 0 1.5rpx 1rpx rgba(255,255,255,.95), inset 0 -1.5rpx 1.5rpx rgba(2,132,199,.25), 0 4rpx 14rpx rgba(56,189,248,.18);
}
.action-dock.dock-hidden { opacity:0; transform:translateY(40rpx); pointer-events:none; }
.night .action-dock {
  border-color:rgba(255,255,255,.22);
  background:linear-gradient(135deg,rgba(30,41,59,.45) 0%,rgba(15,23,42,.22) 100%);
  box-shadow:
    inset 0 2rpx 1.5rpx rgba(255,255,255,.45),
    inset 0 -2rpx 2rpx rgba(0,0,0,.55),
    0 24rpx 54rpx -10rpx rgba(0,0,0,.60);
}
.night .action-dock::before { background:linear-gradient(90deg,transparent,rgba(255,255,255,.45) 30%,rgba(255,255,255,.45) 70%,transparent); }
.night .dock-sheen { background:linear-gradient(105deg,transparent 0%,rgba(255,255,255,.18) 50%,transparent 100%); }
.night .dock-item {
  border-color:rgba(255,255,255,.14);
  background:linear-gradient(135deg,rgba(51,65,85,.35),rgba(30,41,59,.18));
  box-shadow:inset 0 1.5rpx 1rpx rgba(255,255,255,.25), inset 0 -1rpx 1rpx rgba(0,0,0,.45);
  color:#cbd5e1;
}
.night .dock-item-hover { opacity:.82; background:rgba(71,85,105,.45); }
.night .dock-agent { color:#7dd3fc; border-color:rgba(56,189,248,.45); background:linear-gradient(135deg,rgba(56,189,248,.26),rgba(56,189,248,.12)); }
.has-wallpaper .action-dock {
  background:linear-gradient(135deg,rgba(255,255,255,.16) 0%,rgba(255,255,255,.04) 50%,rgba(255,255,255,.09) 100%) !important;
  border-color:rgba(255,255,255,.50) !important;
  backdrop-filter:blur(10px) saturate(130%) !important;
  -webkit-backdrop-filter:blur(10px) saturate(130%) !important;
}
.has-wallpaper .dock-item {
  background:rgba(255,255,255,.08) !important;
  border-color:rgba(255,255,255,.35) !important;
}
.has-wallpaper.night .action-dock {
  background:linear-gradient(135deg,rgba(15,23,42,.45) 0%,rgba(2,6,23,.22) 100%) !important;
}
.has-wallpaper .control-card {
  background:linear-gradient(135deg, rgba(255,255,255,.14) 0%, rgba(255,255,255,.03) 50%, rgba(255,255,255,.08) 100%) !important;
  border-color:rgba(255,255,255,.45) !important;
}
.has-wallpaper .week-chip {
  background:linear-gradient(135deg, rgba(255,255,255,.16), rgba(255,255,255,.05)) !important;
  border-color:rgba(255,255,255,.40) !important;
}
.has-wallpaper .appearance-button,
.has-wallpaper .night-button,
.has-wallpaper .icon-button,
.has-wallpaper button.appearance-button,
.has-wallpaper button.night-button {
  background:radial-gradient(circle at 35% 25%, rgba(255,255,255,.20) 0%, rgba(255,255,255,.03) 60%, rgba(255,255,255,.09) 100%) !important;
  border-color:rgba(255,255,255,.45) !important;
}

/* 顶部控制栏：苹果灵动岛浮动胶囊 (Floating Island) */
.control-wrap { position:relative; z-index:12; margin-top:8rpx; }
.control-card {
  margin-top:0;
  overflow:hidden;
  border-radius:var(--radius-pill);
  border:1.5rpx solid rgba(255,255,255,.65);
  background:linear-gradient(135deg, rgba(255,255,255,.20) 0%, rgba(255,255,255,.06) 50%, rgba(255,255,255,.12) 100%);
  box-shadow:
    0 14rpx 36rpx -8rpx rgba(25,45,80,.16),
    inset 0 2rpx 1.5rpx rgba(255,255,255,.98),
    inset 1.5rpx 0 2rpx rgba(255,255,255,.35),
    inset -1.5rpx 0 2rpx rgba(255,255,255,.20),
    inset 0 -2rpx 2rpx rgba(0,0,0,.16);
  backdrop-filter:blur(12px) saturate(140%);
  -webkit-backdrop-filter:blur(12px) saturate(140%);
}
.term-week-bar { display:flex; align-items:center; justify-content:space-between; gap:16rpx; min-height:92rpx; padding:8rpx 16rpx 8rpx 28rpx; }
.term-picker { display:flex; align-items:center; flex:1; min-width:0; }
.term-picker-hover { opacity:.78; }
.term-title-text { max-width:340rpx; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#172033; font-size:27rpx; font-weight:750; }
.term-chevron { margin-left:8rpx; margin-right:12rpx; color:#64748b; font-size:19rpx; line-height:1; flex:none; opacity:.75; }
.week-inline { display:flex; align-items:stretch; gap:10rpx; flex:none; }

/* 苹果晶体胶囊：第 X 周切换 Pill */
.week-chip {
  display:flex;
  align-items:center;
  gap:10rpx;
  min-height:70rpx;
  padding:0 26rpx;
  border-radius:var(--radius-pill);
  border:1.5rpx solid rgba(255,255,255,.55);
  background:linear-gradient(135deg, rgba(255,255,255,.24), rgba(255,255,255,.08));
  box-shadow:
    0 6rpx 16rpx rgba(25,45,80,.08),
    inset 0 1.5rpx 1rpx rgba(255,255,255,.95),
    inset 0 -1.5rpx 1.5rpx rgba(0,0,0,.12);
  backdrop-filter:blur(12px) saturate(140%);
  -webkit-backdrop-filter:blur(12px) saturate(140%);
  transition:opacity .15s ease;
}
.week-chip-hover { opacity:.82; }
.week-chip-text { color:#172033; font-size:27rpx; font-weight:750; white-space:nowrap; }
.week-chip-arrow { color:#087ca7; font-size:22rpx; line-height:1; opacity:.85; }
.week-chip-badge {
  flex:none;
  padding:4rpx 14rpx;
  border-radius:var(--radius-pill);
  background:rgba(56,189,248,.22);
  border:1rpx solid rgba(56,189,248,.35);
  color:#0369a1;
  font-size:19rpx;
  font-weight:750;
  line-height:1.2;
}
.night .control-card {
  border-color:rgba(255,255,255,.24);
  background:linear-gradient(135deg,rgba(30,41,59,.45) 0%,rgba(15,23,42,.22) 100%);
  box-shadow:0 14rpx 36rpx -8rpx rgba(0,0,0,.50), inset 0 1.5rpx 0.5rpx rgba(255,255,255,.45), inset 0 -1.5rpx 1.5rpx rgba(0,0,0,.50);
}
.night .term-title-text { color:#f1f5f9; }
.night .week-chip {
  border-color:rgba(255,255,255,.22);
  background:linear-gradient(135deg,rgba(51,65,85,.40),rgba(30,41,59,.20));
  box-shadow:0 6rpx 16rpx rgba(0,0,0,.35), inset 0 1.5rpx 0.5rpx rgba(255,255,255,.40);
}
.night .week-chip-text { color:#f1f5f9; }
.night .week-chip-arrow { color:#38bdf8; }
.night .week-chip-badge { background:rgba(56,189,248,.20); color:#7dd3fc; border-color:rgba(56,189,248,.35); }

/* 周面板浮层：苹果高阶液态毛玻璃（高通透 + 强对比清晰文字） */
.week-panel {
  position:absolute;
  top:calc(100% + 12rpx);
  right:0;
  left:0;
  z-index:30;
  padding:20rpx 14rpx 22rpx;
  overflow:hidden;
  border:1.5rpx solid rgba(255,255,255,.65);
  border-radius:var(--radius-lg);
  background:linear-gradient(135deg, rgba(255,255,255,.16) 0%, rgba(255,255,255,.05) 50%, rgba(255,255,255,.10) 100%);
  box-shadow:
    0 20rpx 48rpx -8rpx rgba(15,23,42,.18),
    inset 0 2rpx 1.5rpx rgba(255,255,255,.98),
    inset 1.5rpx 0 2rpx rgba(255,255,255,.35),
    inset 0 -2rpx 2rpx rgba(0,0,0,.15);
  backdrop-filter:blur(14px) saturate(150%);
  -webkit-backdrop-filter:blur(14px) saturate(150%);
}
.has-wallpaper .week-panel {
  background:linear-gradient(135deg, rgba(255,255,255,.10) 0%, rgba(255,255,255,.02) 50%, rgba(255,255,255,.06) 100%) !important;
  border-color:rgba(255,255,255,.45) !important;
}
.week-panel-scroll { height:610rpx; max-height:58vh; }
.week-panel-title {
  display:flex;
  padding:0 10rpx 18rpx;
  align-items:center;
  justify-content:space-between;
  color:#0f172a;
  font-size:26rpx;
  font-weight:780;
}
.week-panel-title text + text { color:#475569; font-size:20rpx; font-weight:600; }
.week-grid { display:flex; flex-wrap:wrap; }
.week-option { width:25%; padding:6rpx; }
.week-option-card {
  min-height:104rpx;
  padding:14rpx 4rpx 10rpx;
  border:1rpx solid rgba(255,255,255,.45);
  border-radius:var(--radius-sm);
  background:rgba(255,255,255,.10);
  box-shadow:inset 0 1.5rpx 1rpx rgba(255,255,255,.85), 0 4rpx 10rpx rgba(15,23,42,.04);
  text-align:center;
  transition:background .2s ease, opacity .15s ease, transform .15s ease;
}
.has-wallpaper .week-option-card {
  background:rgba(255,255,255,.07) !important;
  border-color:rgba(255,255,255,.35) !important;
}
.week-option-card:active { opacity:.82; transform:scale(.97); }
.week-option-card.selected {
  border-color:rgba(255,255,255,.90) !important;
  background:linear-gradient(135deg,#0ea5e9,#2563eb) !important;
  box-shadow:0 8rpx 22rpx rgba(37,99,235,.35), inset 0 2rpx 1rpx rgba(255,255,255,.85) !important;
}
.week-option-title { display:block; color:#0f172a; font-size:24rpx; line-height:1.35; font-weight:750; }
.week-option-range { display:block; margin-top:6rpx; color:#334155; font-size:17rpx; line-height:1.2; font-weight:600; }
.week-option-card.selected .week-option-title,.week-option-card.selected .week-option-range { color:#fff !important; }
.loading-card { margin-top:16rpx; padding:46rpx; color:#64748b; text-align:center; font-size:24rpx; }

/* ===== 空课表状态与使用说明（苹果液态毛玻璃卡） ===== */
.empty {
  margin-top:16rpx;
  padding:48rpx 28rpx 36rpx;
  border:1.5rpx solid var(--glass-regular-border);
  border-radius:var(--radius-lg);
  background:var(--glass-regular-bg);
  box-shadow:var(--glass-regular-shadow), var(--glass-regular-highlight), var(--glass-regular-refraction);
  backdrop-filter:var(--glass-regular-blur);
  -webkit-backdrop-filter:var(--glass-regular-blur);
  text-align:center;
}
.empty-hero { display:flex; flex-direction:column; align-items:center; text-align:center; }
.empty-icon-box {
  display:flex;
  width:112rpx;
  height:112rpx;
  align-items:center;
  justify-content:center;
  border-radius:var(--radius-lg);
  background:linear-gradient(135deg,rgba(255,255,255,.45) 0%,rgba(255,255,255,.15) 100%);
  border:1.5rpx solid rgba(255,255,255,.75);
  box-shadow:0 12rpx 28rpx rgba(14,165,233,.16),inset 0 2rpx 1rpx rgba(255,255,255,1);
}
.empty-icon-glyph { font-size:52rpx; line-height:1; }
.empty-title { display:block; margin-top:22rpx; color:#172033; font-size:34rpx; font-weight:800; letter-spacing:0.5rpx; }
.empty-desc { display:block; max-width:540rpx; margin:12rpx auto 28rpx; color:#64748b; font-size:24rpx; line-height:1.55; }
button.empty-button,
.empty-button {
  display:flex !important;
  width:320rpx !important;
  max-width:320rpx !important;
  height:88rpx !important;
  min-height:88rpx !important;
  margin:0 auto !important;
  padding:0 !important;
  align-items:center !important;
  justify-content:center !important;
  border:1rpx solid rgba(255,255,255,.50) !important;
  border-radius:var(--radius-pill) !important;
  background:linear-gradient(135deg,#0ea5e9 0%,#2563eb 100%) !important;
  box-shadow:0 12rpx 28rpx rgba(14,165,233,.30),inset 0 1.5rpx 0.5rpx rgba(255,255,255,.65) !important;
  color:#fff !important;
  font-size:29rpx !important;
  font-weight:750 !important;
  transition:opacity .15s ease;
}
button.empty-button::after { display:none !important; }
.empty-button-icon { margin-right:6rpx; font-size:30rpx; font-weight:800; line-height:1; }
.empty-button-hover { opacity:.82; }

/* 导入使用说明卡片（Subtle 玻璃层级） */
.empty-guide {
  margin-top:38rpx;
  padding:26rpx 24rpx 22rpx;
  border:1rpx solid var(--glass-subtle-border);
  border-radius:var(--radius-md);
  background:var(--glass-subtle-bg);
  box-shadow:var(--glass-subtle-shadow), inset 0 1.5rpx 0.5rpx rgba(255,255,255,.95);
  backdrop-filter:var(--glass-subtle-blur);
  -webkit-backdrop-filter:var(--glass-subtle-blur);
  text-align:left;
}
.guide-head { display:flex; align-items:center; gap:10rpx; margin-bottom:20rpx; }
.guide-badge { font-size:26rpx; line-height:1; }
.guide-title { font-size:24rpx; font-weight:750; color:#0284c7; letter-spacing:0.3rpx; }
.guide-steps { display:flex; flex-direction:column; gap:16rpx; }
.guide-step { display:flex; align-items:flex-start; gap:16rpx; }
.step-badge {
  display:flex;
  width:38rpx;
  height:38rpx;
  min-width:38rpx;
  align-items:center;
  justify-content:center;
  border-radius:50%;
  background:linear-gradient(135deg,#38bdf8 0%,#2563eb 100%);
  box-shadow:0 4rpx 10rpx rgba(14,165,233,.25);
  color:#fff;
  font-size:20rpx;
  font-weight:800;
  line-height:1;
  margin-top:2rpx;
}
.step-main { flex:1; min-width:0; }
.step-title { display:block; font-size:23rpx; font-weight:700; color:#1e293b; line-height:1.35; }
.step-desc { display:block; margin-top:4rpx; color:#64748b; font-size:21rpx; line-height:1.5; }
.guide-footer { margin-top:18rpx; padding-top:14rpx; border-top:1rpx dashed rgba(148,163,184,.26); }
.guide-footer-tip { display:block; color:#0284c7; font-size:20rpx; font-weight:550; line-height:1.5; }

/* 课表容器：全透光学亚克力画板，100% 透显背景壁纸与光斑 */
.timetable {
  position:relative;
  margin-top:24rpx;
  overflow:hidden;
  border:1.5rpx solid var(--glass-regular-border);
  border-radius:var(--radius-lg);
  background:linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 50%, rgba(255, 255, 255, 0.03) 100%);
  box-shadow:var(--glass-regular-shadow), var(--glass-regular-highlight), var(--glass-regular-refraction);
  backdrop-filter:none !important;
  -webkit-backdrop-filter:none !important;
}
.page-wallpaper { position:absolute; top:0; right:0; bottom:0; left:0; width:100% !important; height:100% !important; z-index:0; pointer-events:none; }
.page-wallpaper-tint { position:absolute; top:0; right:0; bottom:0; left:0; width:100%; height:100%; z-index:0; pointer-events:none; background:transparent; }
.page-wallpaper-bottom-fade {
  position:absolute;
  right:0;
  bottom:0;
  left:0;
  z-index:0;
  height:calc(120rpx + env(safe-area-inset-bottom));
  pointer-events:none;
  background:transparent;
}
.has-wallpaper .page-wallpaper-tint { background:rgba(0,0,0,.04); }
.has-wallpaper .page-wallpaper-bottom-fade { display:none !important; }
.has-wallpaper .timetable {
  background:transparent !important;
  border-color:rgba(255,255,255,.45) !important;
  box-shadow:
    0 16rpx 36rpx -6rpx rgba(15,23,42,.22),
    inset 0 2rpx 1.5rpx rgba(255,255,255,.85),
    inset 0 -1.5rpx 1.5rpx rgba(0,0,0,.15) !important;
  backdrop-filter:none !important;
  -webkit-backdrop-filter:none !important;
}
.has-wallpaper .page-content { background:transparent !important; }
.night.has-wallpaper .page-wallpaper-tint,
.night .page-wallpaper-tint { background:rgba(7,13,25,.42); }
.night .page-wallpaper-bottom-fade { display:none !important; }
.timetable-content { position:relative; z-index:1; }

/* ===== 表头与网格：超清高透光学透镜规范 ===== */
.table-header { display:flex; height:108rpx; background:linear-gradient(180deg,rgba(255,255,255,.14) 0%,rgba(255,255,255,.03) 100%); border-bottom:1rpx solid var(--hairline); box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.85); color:#1f3a4d; }
.has-wallpaper .table-header { background:rgba(255,255,255,.04) !important; border-bottom:1rpx solid rgba(255,255,255,.18) !important; }
.section-head { display:flex; width:70rpx; flex:none; align-items:center; justify-content:center; flex-direction:column; border-right:1rpx solid var(--hairline); font-size:19rpx; line-height:1.45; }
.section-head text:first-child { color:#1e293b; font-size:22rpx; font-weight:700; line-height:1.2; }
.section-head text:last-child { color:#64748b; font-size:18rpx; margin-top:5rpx; line-height:1.2; }
.days-head { display:flex; min-width:0; flex:1; }
.day-head { display:flex; width:14.2857%; align-items:center; justify-content:center; flex-direction:column; border-right:1rpx solid var(--hairline); color:#2b4a5e; transition:background .2s ease; }
.head-date { font-size:22rpx; font-weight:700; color:#1e293b; line-height:1.2; }
.head-day { margin-top:5rpx; font-size:23rpx; font-weight:650; color:#64748b; line-height:1.2; }
.day-head.today { background:linear-gradient(180deg,rgba(56,189,248,.20) 0%,rgba(56,189,248,.03) 100%); box-shadow:inset 0 1.5px 0.5px rgba(56,189,248,.7); }
.day-head.today .head-date { color:#0284c7; font-weight:800; }
.day-head.today .head-day { color:#0284c7; font-weight:750; }
.table-body { position:relative; display:flex; }
.section-column { width:70rpx; flex:none; background:rgba(255,255,255,.06); }
.section-cell { display:flex; height:var(--row-height, 112rpx); align-items:center; justify-content:center; flex-direction:column; border-right:1rpx solid var(--hairline); border-bottom:1rpx solid var(--hairline); color:#425466; }
.section-number { font-size:26rpx; font-weight:700; line-height:1; color:#334155; }
.section-time { margin-top:5rpx; font-size:14rpx; line-height:1; color:#8292a3; }
.day-area { position:relative; display:flex; min-width:0; height:100%; flex:1; }
.day-column { width:14.2857%; }
/* 网格单元格：L0 晶莹 1.5% 微光 */
.grid-cell { height:var(--row-height, 112rpx); border-right:1rpx solid var(--hairline); border-bottom:1rpx solid var(--hairline); background:rgba(255,255,255,.015); }
.course-slot { position:absolute; z-index:2; padding:4rpx 3rpx; }
/* 果冻水晶课程卡：渐变/边框/彩色投影由 JS 按课程色内联注入 */
.grid-course { width:100%; height:100%; padding:9rpx 7rpx; overflow:hidden; border:1rpx solid rgba(255,255,255,.58); border-radius:12rpx; color:#fff; }
.grid-course:active { opacity:.85; }
.adjusted-tag { position:absolute; top:7rpx; right:6rpx; width:26rpx; height:26rpx; border-radius:50%; background:rgba(255,255,255,.92); color:#0f766e; font-size:16rpx; font-weight:800; line-height:26rpx; text-align:center; }
.grid-course-name { display:-webkit-box; -webkit-box-orient:vertical; overflow:hidden; font-size:20rpx; font-weight:750; line-height:1.25; word-break:break-all; text-shadow:0 1px 2px rgba(15,23,42,.30); }
.grid-course-meta { display:block; margin-top:5rpx; overflow:hidden; font-size:15rpx; line-height:1.25; text-overflow:ellipsis; white-space:nowrap; text-shadow:0 1px 2px rgba(15,23,42,.25); }
.no-course {
  position:absolute;
  top:40rpx;
  left:30rpx;
  right:30rpx;
  padding:28rpx;
  border-radius:var(--radius-pill);
  background:var(--glass-liquid-bg);
  box-shadow:var(--glass-regular-shadow), var(--glass-regular-highlight);
  color:#1e3a5f;
  text-align:center;
  font-size:24rpx;
  font-weight:650;
  border:1rpx solid var(--glass-liquid-border);
  backdrop-filter:var(--glass-regular-blur);
  -webkit-backdrop-filter:var(--glass-regular-blur);
}
.bottom-safe { height:18rpx; }

/* 遮罩与弹窗：浅透高斯模糊 + 苹果高阶亮感液态毛玻璃 */
.mask {
  position:fixed;
  top:0; right:0; bottom:0; left:0;
  z-index:20;
  display:flex;
  align-items:flex-end;
  background:radial-gradient(circle at 50% 42%,rgba(15,23,42,.18),rgba(15,23,42,.38));
  backdrop-filter:blur(14px);
  -webkit-backdrop-filter:blur(14px);
}
.dialog {
  width:100%;
  padding:20rpx 30rpx calc(30rpx + env(safe-area-inset-bottom));
  border:1.5rpx solid rgba(255,255,255,.95);
  border-bottom:0;
  border-radius:44rpx 44rpx 0 0;
  background:linear-gradient(145deg, rgba(255,255,255,.95) 0%, rgba(244,248,255,.88) 100%);
  box-shadow:
    0 -24rpx 60rpx -10rpx rgba(25,35,60,.22),
    inset 0 2rpx 1.5rpx rgba(255,255,255,1),
    inset 0 -1.5rpx 1rpx rgba(180,200,230,.30);
  backdrop-filter:blur(36px) saturate(180%);
  -webkit-backdrop-filter:blur(36px) saturate(180%);
}
.dialog { max-height:calc(100% - 24rpx - env(safe-area-inset-top)); overflow:hidden; }
.dialog-handle { width:76rpx; height:8rpx; margin:0 auto 28rpx; border-radius:4rpx; background:rgba(100,116,139,.30); }
.dialog-eyebrow { display:block; color:#0284c7; font-size:22rpx; font-weight:750; }
.dialog-title { display:block; margin:8rpx 0 24rpx; font-size:36rpx; font-weight:800; color:#0f172a; }
.term-field { margin-bottom:16rpx; }
.term-field-label { display:block; margin:0 0 10rpx 4rpx; color:#475569; font-size:23rpx; font-weight:600; }
.term-input { width:100%; height:86rpx; padding:0 22rpx; border:1.5rpx solid rgba(226,232,240,.9); border-radius:20rpx; background:rgba(255,255,255,.85); box-shadow:inset 0 1.5rpx 1rpx rgba(255,255,255,1); color:#0f172a; font-size:26rpx; font-weight:600; }
.filename { display:block; padding:20rpx; overflow:hidden; border-radius:20rpx; background:rgba(255,255,255,.82); border:1.5rpx solid rgba(226,232,240,.9); color:#334155; font-size:23rpx; font-weight:550; text-overflow:ellipsis; white-space:nowrap; }
.date-row { display:flex; min-height:88rpx; margin-top:16rpx; padding:0 22rpx; align-items:center; justify-content:space-between; border:1.5rpx solid rgba(226,232,240,.9); border-radius:20rpx; background:rgba(255,255,255,.82); }
.date-label { color:#475569; font-size:25rpx; font-weight:550; }
.date-value { color:#0f172a; font-size:25rpx; font-weight:700; }
.dialog-actions { display:flex; margin-top:28rpx; gap:16rpx; }
.dialog .btn,
.dialog .dialog-cancel {
  background:rgba(255,255,255,.88) !important;
  border:1.5rpx solid rgba(226,232,240,.9) !important;
  color:#1e293b !important;
  font-weight:700 !important;
  box-shadow:0 4rpx 14rpx rgba(15,23,42,.06), inset 0 1.5rpx 1rpx rgba(255,255,255,1) !important;
}
.dialog .btn:active,
.dialog .dialog-cancel:active {
  background:rgba(255,255,255,1) !important;
  opacity:.9;
}
.dialog .btn.primary,
.dialog .dialog-submit {
  background:linear-gradient(135deg, #0ea5e9, #2563eb) !important;
  color:#ffffff !important;
  border:1rpx solid rgba(255,255,255,.50) !important;
  box-shadow:0 8rpx 22rpx rgba(37,99,235,.35), inset 0 1.5rpx 0.5rpx rgba(255,255,255,.65) !important;
}
.dialog-cancel { flex:1; margin:0 !important; }
.dialog-submit { flex:2; margin:0 !important; }
.privacy-text { display:block; margin:-6rpx 0 6rpx; color:#475569; font-size:25rpx; line-height:1.7; }
.privacy-link { color:#0284c7; font-weight:700; text-decoration:underline; }
.night .privacy-text { color:#cbd5e1; }
.night .privacy-link { color:#7dd3fc; }
.parse-help { display:block; margin:-6rpx 0 20rpx; color:#64748b; font-size:23rpx; line-height:1.55; }
.dialog-close-btn { width:100%; margin-top:14rpx; margin-bottom:18rpx; flex:none; }
.detail-dialog { padding-top:18rpx; }
.detail-title-row { display:flex; margin:10rpx 0 24rpx; align-items:center; }
.detail-color { width:18rpx; height:54rpx; margin-right:14rpx; border-radius:9rpx; }
.detail-title { min-width:0; overflow:hidden; color:#172033; font-size:36rpx; font-weight:780; text-overflow:ellipsis; white-space:nowrap; }
.detail-list { overflow:hidden; border:1.5rpx solid rgba(226,232,240,.9); border-radius:22rpx; background:rgba(255,255,255,.82); box-shadow:0 4rpx 14rpx rgba(15,23,42,.04); }
.detail-item { display:flex; min-height:80rpx; padding:16rpx 22rpx; align-items:center; justify-content:space-between; background:transparent; }
.detail-item + .detail-item { border-top:1rpx solid rgba(226,232,240,.8); }
.detail-item text:first-child { color:#64748b; font-size:24rpx; font-weight:550; }
.detail-item text:last-child { max-width:72%; color:#0f172a; font-size:25rpx; font-weight:700; text-align:right; }
.week-input { width:120rpx; color:#0f172a; font-size:25rpx; font-weight:700; text-align:right; }
.calculate-button { width:100%; height:72rpx; margin:14rpx 0 0; border:1.5rpx solid rgba(125,211,252,.5); border-radius:18rpx; background:rgba(14,165,233,.12); color:#0284c7; font-size:24rpx; font-weight:700; line-height:72rpx; }
.danger-button { margin-right:12rpx; color:#e11d48; background:rgba(244,63,94,.10); border:1.5rpx solid rgba(244,63,94,.25); }
/* 学期设置底部操作栏：删除在左侧独立隔离，取消与保存居右成组，避免误触且严防屏幕右侧溢出 */
.semester-actions { display:flex; align-items:center; justify-content:space-between; margin-top:32rpx; gap:16rpx; width:100%; box-sizing:border-box; }
.semester-btn-delete { margin:0 !important; flex:none; width:170rpx; min-height:84rpx; padding:0 !important; border-radius:24rpx; font-size:25rpx; font-weight:700; color:#e11d48; background:rgba(244,63,94,.10); border:1.5rpx solid rgba(244,63,94,.25); box-shadow:none; }
.semester-btn-group { display:flex; align-items:center; gap:16rpx; flex:1; min-width:0; justify-content:flex-end; box-sizing:border-box; }
.semester-btn-cancel { margin:0 !important; flex:1; min-width:130rpx; max-width:180rpx; min-height:84rpx; padding:0 !important; border-radius:24rpx; font-size:26rpx; font-weight:700; background:rgba(255,255,255,.90) !important; border:1.5rpx solid rgba(226,232,240,.95) !important; color:#1e293b !important; }
.semester-btn-save { margin:0 !important; flex:1.4; min-width:160rpx; max-width:240rpx; min-height:84rpx; padding:0 !important; border-radius:24rpx; font-size:26rpx; font-weight:750; background:linear-gradient(135deg, #0ea5e9, #2563eb) !important; color:#ffffff !important; box-shadow:0 8rpx 22rpx rgba(37,99,235,.35) !important; }
.night .semester-btn-delete { color:#fda4af; background:rgba(244,63,94,.16); border-color:rgba(244,63,94,.32); }
.adjust-course-name { display:block; margin:-8rpx 0 12rpx; padding:18rpx 20rpx; border-radius:18rpx; background:rgba(14,165,233,.10); color:#172033; font-size:27rpx; font-weight:750; }
.adjust-room { margin-top:16rpx; }
.records-dialog { max-height:82vh; padding-bottom:calc(42rpx + env(safe-area-inset-bottom)); display:flex; flex-direction:column; }
.records-list { height:680rpx; max-height:52vh; }
.adjustment-guide { margin:-4rpx 0 18rpx; padding:18rpx 20rpx; border:1rpx solid rgba(255,255,255,.70); border-radius:18rpx; background:linear-gradient(135deg,rgba(255,255,255,.36),rgba(14,165,233,.07)); box-shadow:var(--glass-highlight),0 8rpx 22rpx rgba(42,65,105,.05); }
.adjustment-guide-head { display:flex; align-items:center; justify-content:space-between; }
.adjustment-guide-title { display:block; color:#0369a1; font-size:23rpx; font-weight:750; }
.adjustment-guide-tag { padding:3rpx 14rpx; border-radius:10rpx; background:rgba(14,165,233,.16); color:#0284c7; font-size:20rpx; font-weight:700; line-height:1.4; }
.adjustment-guide-text { display:block; margin-top:8rpx; color:#64748b; font-size:21rpx; line-height:1.55; }
.records-empty { display:block; padding:60rpx 20rpx; color:#8292a3; font-size:24rpx; text-align:center; }
.record-card { margin-bottom:16rpx; padding:20rpx; border:1rpx solid rgba(148,163,184,.24); border-radius:20rpx; background:rgba(255,255,255,.55); }
.record-head { display:flex; align-items:center; justify-content:space-between; }
.record-badge { padding:5rpx 12rpx; border-radius:999rpx; background:rgba(20,184,166,.14); color:#087b6c; font-size:19rpx; font-weight:700; }
.record-time { color:#94a3b8; font-size:17rpx; }
.record-title { display:block; margin-top:14rpx; color:#172033; font-size:25rpx; font-weight:750; }
.record-desc { display:block; margin-top:7rpx; color:#64748b; font-size:21rpx; line-height:1.45; }
.record-revoke { width:auto; min-height:54rpx; height:54rpx; margin:14rpx 0 0 auto; padding:0 20rpx; border-radius:14rpx; background:rgba(244,63,94,.10); color:#b4232f; font-size:21rpx; font-weight:600; display:inline-flex; align-items:center; justify-content:center; line-height:1; }
.record-actions { display:flex; margin-top:14rpx; align-items:center; justify-content:flex-end; gap:12rpx; flex-wrap:wrap; }
.record-actions button { width:auto !important; min-height:54rpx; height:54rpx; margin:0 !important; padding:0 20rpx; border-radius:14rpx; font-size:21rpx; font-weight:600; display:inline-flex; align-items:center; justify-content:center; line-height:1; flex-shrink:0; }
.record-actions button:active { opacity:.80; }
.record-restore { background:rgba(14,165,233,.12); color:#0284c7; }
.record-delete { background:rgba(244,63,94,.10); color:#e11d48; }
.night .page-content { background:transparent; }
.night .orb-a { background:radial-gradient(circle at 35% 35%,rgba(30,64,175,.34),transparent 68%); }
.night .orb-b { background:radial-gradient(circle at 40% 40%,rgba(14,165,233,.24),transparent 66%); }
.night .orb-c { background:radial-gradient(circle at 45% 40%,rgba(13,148,136,.20),transparent 68%); }
.night .orb-d { background:radial-gradient(circle at 40% 40%,rgba(190,24,93,.16),transparent 66%); }
/* 容器玻璃由令牌自动切换夜色,这里只修正文字与个别浮层 */
.night .card,.night .timetable { color:#f8fafc; }
.night .week-panel {
  border-color:rgba(255,255,255,.20);
  background:linear-gradient(135deg,rgba(15,23,42,.65),rgba(30,41,59,.50));
}
.night.has-wallpaper .week-panel {
  background:linear-gradient(135deg,rgba(7,13,25,.55),rgba(15,23,42,.42)) !important;
  border-color:rgba(255,255,255,.16) !important;
}
.night .week-option-card {
  border-color:rgba(255,255,255,.14);
  background:rgba(255,255,255,.05);
}
.night .week-option-title { color:#f8fafc; }
.night .week-option-range { color:#94a3b8; }
.night .week-panel-title { color:#f8fafc; }
.night .week-panel-title text + text { color:#94a3b8; }
.night .title,.night .term-title-text { color:#f8fafc; }
.night .week-chip { background:rgba(30,41,59,.72); }
.night .week-chip-text { color:#f8fafc; }
.night .week-chip-arrow { color:#7dd3fc; }
.night .week-chip-badge { background:rgba(56,189,248,.26); color:#7dd3fc; }
@media (max-width:360px) {
  .page-content { padding-left:10rpx; padding-right:10rpx; }
  .section-head,.section-column { width:64rpx; }
  .grid-course { padding:7rpx 5rpx; }
  .grid-course-name { font-size:18rpx; }
  .grid-course-meta { font-size:13rpx; }
  .term-title-text { max-width:280rpx; }
  .term-card { padding:20rpx 20rpx; }
  .term-card-title { font-size:28rpx; }
  .record-actions button { padding:0 14rpx; font-size:19rpx; }
}

/* ===== 周导航与学期状态 ===== */
.week-copy { display:block; overflow:hidden; }
.week-title { display:block; overflow:hidden; color:#172033; font-size:28rpx; font-weight:750; line-height:1.35; white-space:nowrap; text-overflow:ellipsis; }
.week-tip { display:block; overflow:hidden; margin-top:5rpx; color:#8a9aaa; font-size:20rpx; line-height:1.25; white-space:nowrap; text-overflow:ellipsis; }
.week-panel-tools { display:flex; align-items:center; gap:16rpx; }
.back-now {
  padding:6rpx 18rpx;
  border-radius:999rpx;
  background:rgba(2,132,199,.12);
  color:#0284c7;
  font-size:20rpx;
  font-weight:750;
  border:1rpx solid rgba(2,132,199,.28);
  box-shadow:inset 0 1rpx 0.5rpx rgba(255,255,255,.8);
  transition:opacity .15s ease, background .15s ease;
}
.back-now:active { opacity:.82; background:rgba(2,132,199,.20); }
.back-now.hide { visibility:hidden; }
.night .back-now {
  background:rgba(56,189,248,.18);
  color:#38bdf8;
  border-color:rgba(56,189,248,.35);
}
/* ===== 学期状态胶囊（自然清透毛玻璃徽标） ===== */

/* ===== 移动模式 ===== */
.grid-course { position:relative; }
.grid-course.moving { opacity:.45; border:2rpx dashed rgba(255,255,255,.95) !important; box-shadow:none !important; }
.grid-cell.cell-active:active { background:rgba(56,189,248,.22); }
.move-hint { position:fixed; right:24rpx; bottom:calc(40rpx + env(safe-area-inset-bottom)); left:24rpx; z-index:60; display:flex; align-items:center; justify-content:space-between; padding:18rpx 24rpx; border-radius:22rpx; background:rgba(17,32,51,.78); backdrop-filter:blur(20px); color:#fff; box-shadow:0 14rpx 34rpx rgba(15,23,42,.35); }
.move-hint-text { flex:1; margin-right:16rpx; font-size:23rpx; line-height:1.4; }
.move-hint-cancel { flex:none; height:56rpx; margin:0; padding:0 22rpx; border-radius:14rpx; background:rgba(255,255,255,.16); color:#fff; font-size:21rpx; line-height:56rpx; }
.move-summary { margin-bottom:16rpx; }
.move-target { color:#0284c7 !important; }
.move-tip { display:block; margin:-6rpx 0 4rpx; color:#8a97a6; font-size:21rpx; line-height:1.55; }

/* ===== 课程详情：本课程修改记录 ===== */
.detail-records { margin-top:22rpx; }
.detail-records-title { margin-bottom:12rpx; color:#334155; font-size:24rpx; font-weight:750; }
.records-empty.small { padding:22rpx 12rpx; font-size:21rpx; }
.course-record { margin-bottom:14rpx; padding:16rpx 18rpx; border:1rpx solid rgba(148,163,184,.24); border-radius:16rpx; background:rgba(255,255,255,.55); }
.course-record-diff { margin-top:10rpx; padding:8rpx 12rpx; border-radius:10rpx; background:rgba(148,163,184,.14); color:#475569; font-size:20rpx; line-height:1.5; }
.detail-dialog .record-actions button { height:48rpx; padding:0 14rpx; font-size:18rpx; line-height:48rpx; }

/* ===== 调课中心升级 ===== */
.parse-entry { width:100%; height:76rpx; margin-bottom:18rpx; flex:none; border:1rpx solid rgba(255,255,255,.72); border-radius:18rpx; background:linear-gradient(135deg,rgba(255,255,255,.32),rgba(14,165,233,.09)); box-shadow:var(--glass-highlight),0 8rpx 20rpx rgba(14,165,233,.07); color:#087ca7; font-size:25rpx; font-weight:700; line-height:76rpx; text-align:center; }
.parse-entry::after { display:none; }
.record-expand { background:rgba(148,163,184,.14) !important; color:#475569 !important; }
.record-details { margin-top:14rpx; border-top:1rpx dashed rgba(148,163,184,.35); padding-top:6rpx; }
.record-detail-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:10rpx 0; }
.record-detail-row + .record-detail-row { border-top:1rpx solid rgba(148,163,184,.20); }
.record-detail-text { flex:1; color:#475569; font-size:20rpx; line-height:1.5; }
.record-revoke.small { margin:0; flex:none; min-height:48rpx; height:48rpx; padding:0 16rpx; border-radius:12rpx; font-size:19rpx; font-weight:600; display:inline-flex; align-items:center; justify-content:center; line-height:1; }

/* ===== 图片识别调课结果 ===== */
.parse-loading { display:flex; align-items:center; justify-content:center; flex-direction:column; padding:90rpx 0; color:#64748b; font-size:24rpx; }
.parse-spinner { width:52rpx; height:52rpx; margin-bottom:22rpx; border:5rpx solid rgba(125,211,252,.4); border-top-color:#0284c7; border-radius:50%; animation:parse-spin 1s linear infinite; }
@keyframes parse-spin { to { transform:rotate(360deg); } }
.parse-list { height:640rpx; max-height:56vh; }
.parse-item { display:flex; margin-bottom:14rpx; padding:18rpx; border:1rpx solid rgba(148,163,184,.24); border-radius:18rpx; background:rgba(255,255,255,.55); }
.parse-item.disabled { opacity:.62; }
.parse-item.checked { border-color:rgba(125,211,252,.55); background:rgba(14,165,233,.08); }
.parse-check { flex:none; width:38rpx; height:38rpx; margin-right:16rpx; border:2rpx solid rgba(148,163,184,.45); border-radius:50%; background:rgba(255,255,255,.7); color:#fff; font-size:22rpx; font-weight:800; line-height:34rpx; text-align:center; }
.parse-check.on { border-color:#0284c7; background:#0284c7; }
.parse-copy { min-width:0; flex:1; }
.parse-item-head { display:flex; align-items:center; justify-content:space-between; }
.parse-name { overflow:hidden; color:#172033; font-size:25rpx; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
.parse-status { flex:none; margin-left:12rpx; padding:4rpx 12rpx; border-radius:999rpx; font-size:17rpx; font-weight:700; }
.parse-status.matched { background:rgba(34,197,94,.14); color:#15803d; }
.parse-status.ambiguous { background:rgba(245,158,11,.14); color:#b45309; }
.parse-status.unmatched { background:rgba(239,68,68,.12); color:#b91c1c; }
.parse-week { display:block; margin-top:8rpx; color:#64748b; font-size:20rpx; }
.parse-diff { display:flex; align-items:center; flex-wrap:wrap; gap:8rpx; margin-top:10rpx; padding:10rpx 12rpx; border-radius:10rpx; background:rgba(148,163,184,.14); }
.parse-old { color:#94a3b8; font-size:20rpx; text-decoration:line-through; }
.parse-arrow { color:#0284c7; font-size:20rpx; font-weight:700; }
.parse-new { color:#0369a1; font-size:20rpx; font-weight:650; }
.parse-hint { display:block; margin-top:8rpx; color:#b45309; font-size:19rpx; }

