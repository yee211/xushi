.semester-btn-delete { margin:0 !important; flex:none; width:170rpx; min-height:76rpx; padding:0 !important; border-radius:22rpx; font-size:25rpx; font-weight:600; color:#e11d48; background:rgba(244,63,94,.09); border:1rpx solid rgba(244,63,94,.22); box-shadow:none; }
.semester-btn-group { display:flex; align-items:center; gap:16rpx; flex:1; min-width:0; justify-content:flex-end; box-sizing:border-box; }
.semester-btn-cancel { margin:0 !important; flex:1; min-width:130rpx; max-width:180rpx; min-height:76rpx; padding:0 !important; border-radius:22rpx; font-size:26rpx; }
.semester-btn-save { margin:0 !important; flex:1.4; min-width:160rpx; max-width:240rpx; min-height:76rpx; padding:0 !important; border-radius:22rpx; font-size:26rpx; }
.night .semester-btn-delete { color:#fda4af; background:rgba(244,63,94,.16); border-color:rgba(244,63,94,.32); }
.adjust-course-name { display:block; margin:-8rpx 0 12rpx; padding:18rpx 20rpx; border-radius:18rpx; background:rgba(14,165,233,.10); color:#172033; font-size:27rpx; font-weight:750; }
.adjust-room { margin-top:16rpx; }
.records-dialog { max-height:82vh; padding-bottom:calc(42rpx + env(safe-area-inset-bottom)); display:flex; flex-direction:column; }
.records-list { height:680rpx; max-height:52vh; }
.adjustment-guide { margin:-4rpx 0 18rpx; padding:18rpx 20rpx; border:1rpx solid rgba(255,255,255,.70); border-radius:18rpx; background:linear-gradient(135deg,rgba(255,255,255,.36),rgba(14,165,233,.07)); box-shadow:var(--glass-highlight),0 8rpx 22rpx rgba(42,65,105,.05); }
.adjustment-guide-head { display:flex; align-items:center; justify-content:space-between; }
.adjustment-guide-title { display:block; color:#0369a1; font-size:23rpx; font-weight:750; }
.adjustment-guide-tag { padding:3rpx 14rpx; border-radius:10rpx; background:rgba(14,165,233,.16); color:#0284c7; font-size:20rpx; font-weight:700; line-height:1.4; }
.adjustment-guide-text { display:block; margin-top:8rpx; color:#64748b; font-size:21rpx; line-height:1.55; }
.records-empty { display:block; padding:60rpx 20rpx; color:#8292a3; font-size:24rpx; text-align:center; }
.record-card { margin-bottom:16rpx; padding:20rpx; border:1rpx solid rgba(148,163,184,.24); border-radius:20rpx; background:rgba(255,255,255,.55); }
.record-head { display:flex; align-items:center; justify-content:space-between; }
.record-badge { padding:5rpx 12rpx; border-radius:999rpx; background:rgba(20,184,166,.14); color:#087b6c; font-size:19rpx; font-weight:700; }
.record-time { color:#94a3b8; font-size:17rpx; }
.record-title { display:block; margin-top:14rpx; color:#172033; font-size:25rpx; font-weight:750; }
.record-desc { display:block; margin-top:7rpx; color:#64748b; font-size:21rpx; line-height:1.45; }
.record-revoke { width:auto; min-height:54rpx; height:54rpx; margin:14rpx 0 0 auto; padding:0 20rpx; border-radius:14rpx; background:rgba(244,63,94,.10); color:#b4232f; font-size:21rpx; font-weight:600; display:inline-flex; align-items:center; justify-content:center; line-height:1; }
.record-actions { display:flex; margin-top:14rpx; align-items:center; justify-content:flex-end; gap:12rpx; flex-wrap:wrap; }
.record-actions button { width:auto !important; min-height:54rpx; height:54rpx; margin:0 !important; padding:0 20rpx; border-radius:14rpx; font-size:21rpx; font-weight:600; display:inline-flex; align-items:center; justify-content:center; line-height:1; flex-shrink:0; }
.record-actions button:active { opacity:.75; transform:scale(.97); }
.record-restore { background:rgba(14,165,233,.12); color:#0284c7; }
.record-delete { background:rgba(244,63,94,.10); color:#e11d48; }
.night .page-content { background:transparent; }
.night .orb-a { background:radial-gradient(circle at 35% 35%,rgba(30,64,175,.34),transparent 68%); }
.night .orb-b { background:radial-gradient(circle at 40% 40%,rgba(14,165,233,.24),transparent 66%); }
.night .orb-c { background:radial-gradient(circle at 45% 40%,rgba(13,148,136,.20),transparent 68%); }
.night .orb-d { background:radial-gradient(circle at 40% 40%,rgba(190,24,93,.16),transparent 66%); }
/* 容器玻璃由令牌自动切换夜色,这里只修正文字与个别浮层 */
.night .card,.night .timetable { color:#f8fafc; }
.night .week-panel { border-color:rgba(148,163,184,.28); background:linear-gradient(135deg,rgba(15,23,42,.88),rgba(30,41,59,.78)); }
.night .week-option-card { border-color:rgba(148,163,184,.18); background:rgba(30,41,59,.66); }
.night .week-option-title { color:#f8fafc; }
.night .title,.night .term-title-text { color:#f8fafc; }
.night .week-chip { background:rgba(30,41,59,.72); }
.night .week-chip-text { color:#f8fafc; }
.night .week-chip-arrow { color:#7dd3fc; }
.night .week-chip-badge { background:rgba(56,189,248,.26); color:#7dd3fc; }
@media (max-width:360px) {
  .page-content { padding-left:10rpx; padding-right:10rpx; }
  .section-head,.section-column { width:64rpx; }
  .grid-course { padding:7rpx 5rpx; }
  .grid-course-name { font-size:18rpx; }
  .grid-course-meta { font-size:13rpx; }
  .term-title-text { max-width:280rpx; }
  .term-card { padding:20rpx 20rpx; }
  .term-card-title { font-size:28rpx; }
  .record-actions button { padding:0 14rpx; font-size:19rpx; }
}

/* ===== 周导航与学期状态 ===== */
.week-copy { display:block; overflow:hidden; }
.week-title { display:block; overflow:hidden; color:#172033; font-size:28rpx; font-weight:750; line-height:1.35; white-space:nowrap; text-overflow:ellipsis; }
.week-tip { display:block; overflow:hidden; margin-top:5rpx; color:#8a9aaa; font-size:20rpx; line-height:1.25; white-space:nowrap; text-overflow:ellipsis; }
.week-panel-tools { display:flex; align-items:center; gap:16rpx; }
.back-now { padding:6rpx 16rpx; border-radius:999rpx; background:rgba(20,184,166,.14); color:#0f766e; font-size:19rpx; font-weight:700; }
.back-now.hide { visibility:hidden; }
/* ===== 学期状态胶囊（自然清透毛玻璃徽标） ===== */

/* ===== 移动模式 ===== */
.grid-course { position:relative; }
.grid-course.moving { opacity:.45; border:2rpx dashed rgba(255,255,255,.95) !important; box-shadow:none !important; }
.grid-cell.cell-active:active { background:rgba(56,189,248,.22); }
.move-hint { position:fixed; right:24rpx; bottom:calc(40rpx + env(safe-area-inset-bottom)); left:24rpx; z-index:60; display:flex; align-items:center; justify-content:space-between; padding:18rpx 24rpx; border-radius:22rpx; background:rgba(17,32,51,.78); backdrop-filter:blur(20px); color:#fff; box-shadow:0 14rpx 34rpx rgba(15,23,42,.35); }
.move-hint-text { flex:1; margin-right:16rpx; font-size:23rpx; line-height:1.4; }
.move-hint-cancel { flex:none; height:56rpx; margin:0; padding:0 22rpx; border-radius:14rpx; background:rgba(255,255,255,.16); color:#fff; font-size:21rpx; line-height:56rpx; }
.move-summary { margin-bottom:16rpx; }
.move-target { color:#0284c7 !important; }
.move-tip { display:block; margin:-6rpx 0 4rpx; color:#8a97a6; font-size:21rpx; line-height:1.55; }

/* ===== 课程详情：本课程修改记录 ===== */
.detail-records { margin-top:22rpx; }
.detail-records-title { margin-bottom:12rpx; color:#334155; font-size:24rpx; font-weight:750; }
.records-empty.small { padding:22rpx 12rpx; font-size:21rpx; }
.course-record { margin-bottom:14rpx; padding:16rpx 18rpx; border:1rpx solid rgba(148,163,184,.24); border-radius:16rpx; background:rgba(255,255,255,.55); }
.course-record-diff { margin-top:10rpx; padding:8rpx 12rpx; border-radius:10rpx; background:rgba(148,163,184,.14); color:#475569; font-size:20rpx; line-height:1.5; }
.detail-dialog .record-actions button { height:48rpx; padding:0 14rpx; font-size:18rpx; line-height:48rpx; }

/* ===== 调课中心升级 ===== */
.parse-entry { width:100%; height:76rpx; margin-bottom:18rpx; flex:none; border:1rpx solid rgba(255,255,255,.72); border-radius:18rpx; background:linear-gradient(135deg,rgba(255,255,255,.32),rgba(14,165,233,.09)); box-shadow:var(--glass-highlight),0 8rpx 20rpx rgba(14,165,233,.07); color:#087ca7; font-size:25rpx; font-weight:700; line-height:76rpx; text-align:center; }
.parse-entry::after { display:none; }
.record-expand { background:rgba(148,163,184,.14) !important; color:#475569 !important; }
.record-details { margin-top:14rpx; border-top:1rpx dashed rgba(148,163,184,.35); padding-top:6rpx; }
.record-detail-row { display:flex; align-items:center; justify-content:space-between; gap:12rpx; padding:10rpx 0; }
.record-detail-row + .record-detail-row { border-top:1rpx solid rgba(148,163,184,.20); }
.record-detail-text { flex:1; color:#475569; font-size:20rpx; line-height:1.5; }
.record-revoke.small { margin:0; flex:none; min-height:48rpx; height:48rpx; padding:0 16rpx; border-radius:12rpx; font-size:19rpx; font-weight:600; display:inline-flex; align-items:center; justify-content:center; line-height:1; }

/* ===== 图片识别调课结果 ===== */
.parse-loading { display:flex; align-items:center; justify-content:center; flex-direction:column; padding:90rpx 0; color:#64748b; font-size:24rpx; }
.parse-spinner { width:52rpx; height:52rpx; margin-bottom:22rpx; border:5rpx solid rgba(125,211,252,.4); border-top-color:#0284c7; border-radius:50%; animation:parse-spin 1s linear infinite; }
@keyframes parse-spin { to { transform:rotate(360deg); } }
.parse-list { height:640rpx; max-height:56vh; }
.parse-item { display:flex; margin-bottom:14rpx; padding:18rpx; border:1rpx solid rgba(148,163,184,.24); border-radius:18rpx; background:rgba(255,255,255,.55); }
.parse-item.disabled { opacity:.62; }
.parse-item.checked { border-color:rgba(125,211,252,.55); background:rgba(14,165,233,.08); }
.parse-check { flex:none; width:38rpx; height:38rpx; margin-right:16rpx; border:2rpx solid rgba(148,163,184,.45); border-radius:50%; background:rgba(255,255,255,.7); color:#fff; font-size:22rpx; font-weight:800; line-height:34rpx; text-align:center; }
.parse-check.on { border-color:#0284c7; background:#0284c7; }
.parse-copy { min-width:0; flex:1; }
.parse-item-head { display:flex; align-items:center; justify-content:space-between; }
.parse-name { overflow:hidden; color:#172033; font-size:25rpx; font-weight:750; text-overflow:ellipsis; white-space:nowrap; }
.parse-status { flex:none; margin-left:12rpx; padding:4rpx 12rpx; border-radius:999rpx; font-size:17rpx; font-weight:700; }
.parse-status.matched { background:rgba(34,197,94,.14); color:#15803d; }
.parse-status.ambiguous { background:rgba(245,158,11,.14); color:#b45309; }
.parse-status.unmatched { background:rgba(239,68,68,.12); color:#b91c1c; }
.parse-week { display:block; margin-top:8rpx; color:#64748b; font-size:20rpx; }
.parse-diff { display:flex; align-items:center; flex-wrap:wrap; gap:8rpx; margin-top:10rpx; padding:10rpx 12rpx; border-radius:10rpx; background:rgba(148,163,184,.14); }
.parse-old { color:#94a3b8; font-size:20rpx; text-decoration:line-through; }
.parse-arrow { color:#0284c7; font-size:20rpx; font-weight:700; }
.parse-new { color:#0369a1; font-size:20rpx; font-weight:650; }
.parse-hint { display:block; margin-top:8rpx; color:#b45309; font-size:19rpx; }

/* ===== 夜间模式适配：超清微晶与高对比度可见度调校 ===== */
.night .table-header { background:linear-gradient(180deg,rgba(15,23,42,.32) 0%,rgba(2,6,23,.14) 100%); box-shadow:inset 0 1.5px 0.5px rgba(255,255,255,.18); border-bottom-color:var(--hairline); color:#f1f5f9; }
.night .section-head text:first-child { color:#f1f5f9; text-shadow:none; }
.night .section-head text:last-child { color:#94a3b8; }
.night .day-head { color:#94a3b8; }
.night .head-date { color:#f1f5f9; }
.night .head-day { color:#94a3b8; }
.night .day-head.today { background:linear-gradient(180deg,rgba(56,189,248,.26) 0%,rgba(56,189,248,.05) 100%); box-shadow:inset 0 1.5px 0.5px rgba(56,189,248,.75); }
.night .day-head.today .head-date { color:#38bdf8; text-shadow:0 0 12rpx rgba(56,189,248,.65); }
.night .day-head.today .head-day { color:#38bdf8; text-shadow:0 0 12rpx rgba(56,189,248,.65); }
.night .section-column { background:rgba(15,23,42,.22); }
.night .section-cell { color:#94a3b8; }
.night .section-number { color:#e2e8f0; }
.night .section-time { color:#64748b; }
.night .grid-cell { background:rgba(255,255,255,.015); }
.night .night .night .night .night .back-now { background:rgba(13,148,136,.22); color:#5eead4; }
.night .move-hint { background:rgba(15,23,42,.85); }
.night .course-record,.night .parse-item,.night .course-record-diff,.night .parse-diff { border-color:rgba(148,163,184,.2); background:rgba(30,41,59,.6); color:#e2e8f0; }
.night .course-record-diff,.night .record-detail-text,.night .parse-diff { color:#cbd5e1; }
.night .parse-entry { border-color:rgba(125,211,252,.3); background:linear-gradient(135deg,rgba(14,165,233,.16),rgba(14,165,233,.08)); color:#7dd3fc; }
.night .parse-item.checked { border-color:rgba(125,211,252,.45); background:rgba(14,165,233,.12); }
.night .parse-check { border-color:#475569; background:rgba(30,41,59,.8); }
.night .parse-check.on { border-color:#38bdf8; background:#0284c7; }
.night .record-expand { background:rgba(148,163,184,.14) !important; color:#cbd5e1 !important; }
.night .detail-list,.night .detail-item { border-color:rgba(148,163,184,.2); }
.night .detail-item { background:rgba(30,41,59,.5); }
.records-jump { display:block; width:auto; margin:26rpx 30rpx 0; padding:0 26rpx; height:72rpx; border-radius:16rpx; background:rgba(14,165,233,.10); color:#0369a1; font-size:23rpx; font-weight:650; line-height:72rpx; }
.night .records-jump { background:rgba(14,165,233,.14); color:#7dd3fc; }

/* ===== 弹窗/面板动画 ===== */
@keyframes mask-in { from { opacity: 0; } to { opacity: 1; } }
@keyframes dialog-in { from { opacity: 0; transform: translateY(64rpx) scale(.96); } to { opacity: 1; transform: none; } }
@keyframes panel-in { from { opacity: 0; transform: translateY(-10rpx); } to { opacity: 1; transform: none; } }
.mask { animation: mask-in .2s ease-out; }
.dialog { animation: dialog-in .28s cubic-bezier(.34,1.4,.64,1); }
.week-panel { animation: panel-in .18s ease-out; }

/* ===== 交互补充 ===== */
.popover-mask { position:fixed; top:0; right:0; bottom:0; left:0; z-index:25; background:transparent; }
.course-pressed { filter:brightness(.88); transform:scale(.98); }
.ghost-slot { z-index:3; pointer-events:none; }
.ghost-course { width:100%; height:100%; border:3rpx dashed rgba(14,165,233,.95); border-radius:12rpx; background:rgba(14,165,233,.16); }
.import-progress { display:flex; min-height:88rpx; margin-top:18rpx; padding:0 20rpx; align-items:center; gap:18rpx; border-radius:18rpx; background:rgba(14,165,233,.10); color:#0369a1; font-size:23rpx; }
.import-spinner { width:36rpx; height:36rpx; flex:none; border:5rpx solid rgba(125,211,252,.4); border-top-color:#0284c7; border-radius:50%; animation:parse-spin 1s linear infinite; }
.parse-privacy { display:block; margin-top:14rpx; color:#94a3b8; font-size:19rpx; line-height:1.5; text-align:center; }
/* ===== 导入课表样式 ===== */
.import-dialog { max-height:86vh; display:flex; flex-direction:column; }

.excel-pick-card { display:flex; flex-direction:column; align-items:center; justify-content:center; padding:36rpx 20rpx; border:2rpx dashed rgba(14,165,233,.34); border-radius:22rpx; background:linear-gradient(135deg,rgba(255,255,255,.30),rgba(14,165,233,.05)); box-shadow:inset 0 1.5px .5px rgba(255,255,255,.82); margin-bottom:20rpx; transition:background .2s; }
.excel-pick-card:active { background:rgba(14,165,233,.10); }
.excel-pick-icon { width:64rpx; height:64rpx; border-radius:50%; background:rgba(14,165,233,.14); color:#0284c7; font-size:36rpx; font-weight:700; display:flex; align-items:center; justify-content:center; margin-bottom:12rpx; }
.excel-pick-title { font-size:27rpx; font-weight:700; color:#0369a1; }
.excel-pick-desc { font-size:21rpx; color:#64748b; margin-top:6rpx; }

.excel-file-card { display:flex; align-items:center; padding:20rpx 24rpx; border-radius:20rpx; background:rgba(255,255,255,.65); border:1rpx solid rgba(148,163,184,.28); margin-bottom:20rpx; }
.excel-file-icon { font-size:38rpx; margin-right:18rpx; flex:none; }
.excel-file-info { min-width:0; flex:1; }
.filename-text { display:block; font-size:26rpx; font-weight:700; color:#1e293b; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.file-change-hint { display:block; font-size:20rpx; color:#0284c7; margin-top:4rpx; }
.night .excel-pick-card { border-color:rgba(56,189,248,.35); background:rgba(14,165,233,.08); }
.night .excel-pick-icon { background:rgba(56,189,248,.2); color:#7dd3fc; }
.night .excel-pick-title { color:#7dd3fc; }
.night .excel-pick-desc { color:#94a3b8; }
.night .excel-file-card { background:rgba(30,41,59,.6); border-color:rgba(148,163,184,.22); }
.night .filename-text { color:#f1f5f9; }
.night .file-change-hint { color:#38bdf8; }


/* ===== 学期状态卡 ===== */
.semester-status { display:flex; align-items:center; margin-bottom:18rpx; padding:20rpx 22rpx; border-radius:18rpx; background:rgba(20,184,166,.12); }
.semester-status .status-dot { width:18rpx; height:18rpx; flex:none; margin-right:16rpx; border-radius:50%; background:#14b8a6; box-shadow:0 0 14rpx rgba(20,184,166,.65); }
.semester-status .status-copy { min-width:0; flex:1; }
