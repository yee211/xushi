# ===== 序时统一后端配置示例 =====
# 复制为 .env 后按需填写；带 * 的项生产环境必填。

# ---- 运行环境 ----
# production / development / test；未显式配置时按生产处理
APP_ENV=development

# ---- 数据库 * ----
DATABASE_URL=postgresql://postgres@127.0.0.1:5432/xushi_schedule
# 连接池
DB_POOL_MIN_SIZE=4
DB_POOL_MAX_SIZE=30
DB_POOL_TIMEOUT=15.0

# ---- 网页端鉴权（邮箱注册登录） ----
# 生产环境必须为至少 32 字符的随机字符串
JWT_SECRET=dev-insecure-secret-change-me
JWT_EXPIRE_MINUTES=10080
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost,http://localhost:5173
AUTH_RATE_LIMIT=10
AUTH_RATE_WINDOW_SECONDS=300
TRUST_PROXY_HEADERS=false

# ---- 小程序鉴权（微信登录） ----
WECHAT_APP_ID=
WECHAT_APP_SECRET=
# 开发环境联调后门：APP_ENV=development 时 code=dev 直接登录为该 openid
# WECHAT_DEV_OPENID=local-dev-user
SESSION_DAYS=30

# ---- 上传限制（二选一） ----
MAX_UPLOAD_BYTES=10485760
# MAX_UPLOAD_MB=10

# ---- AI 课表解析（OpenAI 兼容协议，可选；留空则回退本地解析） ----
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_TIMEOUT_SECONDS=75
AI_MAX_INPUT_CHARS=60000

# ---- 调课通知视觉识别（可选；缺省回落 AI_* 三项） ----
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
VISION_TIMEOUT_SECONDS=45
VISION_MAX_OUTPUT_TOKENS=2000
VISION_ENABLE_THINKING=false

# ---- 课表 Agent（微信 ClawBot / 企业微信渠道） ----
AGENT_CHANNEL_PROVIDER=weixin_ilink
AGENT_BASE_URL=
AGENT_API_KEY=
AGENT_MODEL=
AGENT_TIMEOUT_SECONDS=15
AGENT_REDIS_URL=redis://127.0.0.1:6379/0
AGENT_CONTEXT_TTL_SECONDS=7200
BINDING_CODE_TTL_SECONDS=300
# iLink 凭证加密密钥：openssl rand -base64 32 生成，投入使用后必须固定
WEIXIN_ILINK_CREDENTIAL_KEY=
WEIXIN_ILINK_CHANNEL_VERSION=2.4.8
WEIXIN_ILINK_APP_ID=bot
WEIXIN_ILINK_BOT_AGENT=XuShiSchedule/1.0.0
WEIXIN_ILINK_ROUTE_TAG=
WEIXIN_WORKER_CONCURRENCY=16
WEIXIN_ILINK_POLL_TIMEOUT_SECONDS=2.0

# ---- 企业微信智能机器人回调（可选） ----
WECOM_CALLBACK_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_AIBOT_ID=
WECOM_CORP_ID=

# ---- 反馈通知与推送 ----
WECOM_FEEDBACK_WEBHOOK_URL=
FEEDBACK_ANON_SALT=
APP_TIMEZONE=Asia/Shanghai
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_CACHE_MINUTES=60
MORNING_PUSH_TIME=07:30
MORNING_PUSH_ENABLED=true

# ---- 管理后台（/admin） ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_SECONDS=28800
LLM_CONFIG_ENCRYPTION_KEY=

# ---- 演示账号（接管无主数据；生产环境禁止使用默认密码） ----
DEFAULT_USERNAME=demo
DEFAULT_EMAIL=demo@example.com
DEFAULT_PASSWORD=demo1234
