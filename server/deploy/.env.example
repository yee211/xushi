# 部署环境变量（复制为 .env 后填写；此文件已被 Git 忽略）
# 必须包含安卓 WebView 来源 https://localhost / http://localhost 与 iOS 的 capacitor://localhost，
# 否则安卓 App 登录会报"网络连接失败"（CORS 预检 400）
CORS_ORIGINS=https://tanzeng.xyz,https://api.tanzeng.xyz,https://localhost,http://localhost,capacitor://localhost
DB_PASSWORD=
JWT_SECRET=
DEFAULT_PASSWORD=
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WEIXIN_ILINK_CREDENTIAL_KEY=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
LLM_CONFIG_ENCRYPTION_KEY=
WECOM_FEEDBACK_WEBHOOK_URL=
FEEDBACK_ANON_SALT=
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
VISION_BASE_URL=
VISION_API_KEY=
VISION_MODEL=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
MORNING_PUSH_TIME=07:30
MORNING_PUSH_ENABLED=true
# 07:30 起多久内允许重试未送达的晨报；超过窗口当天不再补发（避免全天重试）
MORNING_PUSH_RETRY_WINDOW_MINUTES=180

# School sync worker; one elected executor across API processes
ACADEMIC_SYNC_WORKER_ENABLED=true

# 完整学生目录后台采集器
ACADEMIC_DIRECTORY_WORKER_ENABLED=true

# 启用管理后台学校浏览器登录维护：修改后需要重新构建 API 镜像
INSTALL_ACADEMIC_BROWSER=false
